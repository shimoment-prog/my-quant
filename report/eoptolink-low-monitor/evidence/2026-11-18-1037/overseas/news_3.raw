ian@staff.sina.com.cn","mender":"yujian@staff.sina.com.cn","create_time":"2026-11-18 07:06:48","update_time":"2026-11-18 07:06:48","is_need_check":"0","check_time":"1970-01-01 08:00:01","check_status":"1","check_user":"","is_delete":0,"top_value":0,"is_focus":0,"source_content_id":"0","anchor_image_url":"","anchor":"","ext":"{\"stocks\":[{\"market\":\"fund\",\"symbol\":\"159352\",\"key\":\"\\u6295\\u8d44\",\"sym_party_status\":\"1\"}],\"needPushWB\":false,\"needCMSLink\":true,\"needCalender\":false,\"terms\":[],\"docurl\":\"https:\\\/\\\/finance.sina.com.cn\\\/7x24\\\/2026-11-18\\\/doc-inizayrp5031405.shtml\",\"docid\":\"nizayrp5031405\"}","old_live_cid":"0","tab":"","is_repeat":"0","tag":[{"id":"1","name":"\u5b8f\u89c2"}],"like_nums":0,"comment_list":{"list":[],"total":0,"thread_show":0,"qreply":0,"qreply_show":0,"show":0},"docurl":"https:\/\/finance.sina.cn\/7x24\/2026-11-18\/detail-inizayrp5031405.d.html","rich_text_nick_to_url":[],"rich_text_nick_to_routeUri":[],"compere_info":""},{"id":5221038,"zhibo_id":152,"type":1,"rich_text":"\u4eca\u5929\u300a\u4eba\u6c11\u65e5\u62a5\u300b\u5934\u7248\u7684\u4e3b\u8981\u5185\u5bb9\u6709\uff1a\n1\u3001\u4e60\u8fd1\u5e73\u4f1a\u89c1\u8d8a\u5171\u4e2d\u592e\u603b\u4e66\u8bb0\u3001\u56fd\u5bb6\u4e3b\u5e2d\u82cf\u6797\n2\u3001\u4e60\u8fd1\u5e73\u4f1a\u89c1\u58a8\u897f\u54e5\u603b\u7edf\u8f9b\u9c8d\u59c6\n3\u3001\u4e60\u8fd1\u5e73\u4f1a\u89c1\u79d8\u9c81\u603b\u7edf\u85e4\u68ee\u5e86\u5b50\n4\u3001\u4e60\u8fd1\u5e73\u4f1a\u89c1\u667a\u5229\u603b\u7edf\u5361\u65af\u7279\n5\u3001\u4e60\u8fd1\u5e73\u4f1a\u89c1\u52a0\u62ff\u5927\u603b\u7406\u5361\u5c3c\n6\u3001\u4e60\u8fd1\u5e73\u4f1a\u89c1\u5df4\u5e03\u4e9a\u65b0\u51e0\u5185\u4e9a\u603b\u7406\u9a6c\u62c9\u4f69\n7\u3001\u4e60\u8fd1\u5e73\u5bf9\u4eba\u6c11\u6cd5\u9662\u5de5\u4f5c\u4f5c\u51fa\u91cd\u8981\u6307\u793a\u5f3a\u8c03 \u52a0\u5feb\u5efa\u8bbe\u516c\u6b63\u9ad8\u6548\u6743\u5a01\u7684\u793e\u4f1a\u4e3b\u4e49\u53f8\u6cd5\u5236\u5ea6 \u4ee5\u9ad8\u8d28\u91cf\u53f8\u6cd5\u66f4\u