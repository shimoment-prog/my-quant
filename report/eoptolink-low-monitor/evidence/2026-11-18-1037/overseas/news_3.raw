0c1\u7814\u7a76\u4e0e\u7f51\u7edc\u5de5\u7a0b\u603b\u76d1Joe Slowik\u8868\u793a\uff0c\u5982\u6b64\u591a\u5f15\u4eba\u5173\u6ce8\u7684\u4e8b\u4ef6\u5728\u77ed\u65f6\u95f4\u5185\u5bc6\u96c6\u53d1\u751f\uff0c\u65e2\u4e0d\u5bfb\u5e38\uff0c\u4e5f\u4ee4\u4eba\u62c5\u5fe7\u3002\u201c\u6211\u4eec\u5df2\u7ecf\u8fc7\u5ea6\u4f9d\u8d56\u90a3\u4e9b\u6447\u6447\u6b32\u5760\u7684\u57fa\u7840\u8bbe\u65bd\uff0c\u5374\u9ad8\u4f30\u5176\u53ef\u9760\u7a0b\u5ea6\u3002\u201d\u5c3d\u7ba1\u6ca1\u6709\u516c\u5f00\u8ff9\u8c61\u663e\u793a\u8fd9\u4e9b\u8ba1\u7b97\u673a\u6545\u969c\u76f8\u4e92\u5173\u8054\u6216\u7531\u9ed1\u5ba2\u9020\u6210\uff0c\u4f46\u7efc\u5408\u6765\u770b\uff0c\u5b83\u4eec\u89e6\u52a8\u4e86\u56f4\u7ed5AI\u7684\u66f4\u5e7f\u6cdb\u7126\u8651\uff0c\u5305\u62ecAI\u5de5\u5177\u53ef\u80fd\u8ba9\u6076\u610f\u884c\u4e3a\u65b9\u66f4\u5bb9\u6613\u762b\u75ea\u5173\u952e\u670d\u52a1\uff0c\u6216\u5927\u89c4\u6a21\u5b9e\u65bd\u7f51\u7edc\u72af\u7f6a\u3002","multimedia":"","commentid":"live:finance-152-5221129:0","compere_id":0,"creator":"yongsheng6@staff.sina.com.cn","mender":"yongsheng6@staff.sina.com.cn","create_time":"2026-11-18 08:20:28","update_time":"2026-11-18 08:20:28","is_need_check":"0","check_time":"1970-01-01 08:00:01","check_status":"1","check_user":"","is_delete":0,"top_value":0,"is_focus":0,"source_content_id":"0","anchor_image_url":"","anchor":"","ext":"{\"stocks\":[{\"market\":\"us\",\"symbol\":\"cost\",\"key\":\"\\u5f00\\u5e02\\u5ba2\"},{\"market\":\"cn\",\"symbol\":\"sih30192\",\"key\":\"\\u98df\\u54c1\"},{\"market\":\"cn\",\"symbol\":\"sih30182\",\"key\":\"\\u8ba1\\u7b97\\u673a\"},{\"market\":\"fund\",\"symbol\":\"159363\",\"key\":\"AI\",\"sym_party_status\":\"1\"}],\"needPushWB\":false,\"needCMSLink\":true,\"needCalender\":false,\"terms\":[],\"docurl\":\"https:\\\/\\\/finance.sina.com.cn\\\/7x24\\\/2026-11-18\\\/doc-inizcexm4944038.shtml\",\"docid\":\"nizcexm4944038\"}","old_live_cid":"0","tab":"","is_repeat":"0","tag":[{"id":"3","name":"\u516c\u53f8"},{"id":"102","n