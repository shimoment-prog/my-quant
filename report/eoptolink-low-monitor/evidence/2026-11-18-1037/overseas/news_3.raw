_nick_to_url":[],"rich_text_nick_to_routeUri":[],"compere_info":""},{"id":5221040,"zhibo_id":152,"type":0,"rich_text":"\u3010\u82f1\u4f1f\u8fbe\u5206\u6790\u5e08\u7535\u8bdd\u4f1a\u8bae\u8981\u70b9\u603b\u7ed3\u3011 \u4e00\u3001\u9886\u5bfc\u5c42\u7ee7\u4efb\u4e0e\u516c\u53f8\u6cbb\u7406\u3002\n\n1\u3001\u8463\u4e8b\u4f1a\u4e3b\u5e2d\u54c8\u7ef4\u00b7\u743c\u65af\uff08Harvey Jones\uff09\u660e\u786e\u8868\u793a\uff0c\u9ec4\u4ec1\u52cb\u4e0d\u4f1a\u56de\u5f52\u3002\u91cd\u7533\u9ec4\u4ec1\u52cb\uff08Jensen Huang\uff09\u7cfb\u201c\u81ea\u613f\u8f9e\u804c\u201d\uff0c\u5e76\u660e\u786e\u8868\u793a\u8463\u4e8b\u4f1a\u65e0\u610f\u91cd\u65b0\u4efb\u547d\u5176\u62c5\u4efb\u9996\u5e2d\u6267\u884c\u5b98\u3002\n\n2\u3001\u5ba1\u614e\u63a8\u8fdbCEO\u9074\u9009\uff1a \u8463\u4e8b\u4f1a\u6b63\u5728\u8bc4\u4f30\u5185\u90e8\u548c\u5916\u90e8\u5019\u9009\u4eba\u3002\u743c\u65af\u5f3a\u8c03\uff0c\u9074\u9009\u5de5\u4f5c\u201c\u5c06\u5341\u5206\u5ba1\u614e\u201d\uff0c\u5728\u627e\u5230\u80fd\u591f\u9a7e\u9a6d\u5148\u8fdb\u82af\u7247\u4e0e\u56fd\u5bb6\u5b89\u5168\u9886\u57df\u91cd\u5927\u5e02\u573a\u53d8\u9769\u7684\u201c\u5408\u9002\u4eba\u9009\u201d\u4e4b\u524d\uff0c\u4e0d\u4f1a\u4ed3\u4fc3\u505a\u51fa\u51b3\u5b9a\u3002\n\n3\u3001\u76d1\u7ba1\u6c9f\u901a\u4e0e\u4e0d\u63a5\u53d7\u76f8\u5173\u63d0\u95ee\uff1a \u743c\u65af\u5ba3\u5e03\u6210\u7acb\u65b0\u7684\u201c\u56fd\u5bb6\u5b89\u5168\u4e0e\u51fa\u53e3\u7ba1\u5236\u76d1\u7763\u59d4\u5458\u4f1a\u201d\uff0c\u4ee5\u52a0\u5f3a\u4e0e\u7f8e\u56fd\u653f\u5e9c\u76f8\u5173\u673a\u6784\u7684\u6c9f\u901a\u3002\u4ed6\u8fd8\u660e\u786e\u8868\u793a\uff0c\u9ad8\u7ba1\u56e2\u961f\u5728\u672c\u6b21\u4f1a\u8bae\u4e0a\u4e0d\u4f1a\u5c31\u9ec4\u4ec1\u52cb\u79bb\u804c\u7684\u5177\u4f53\u60c5\u51b5\u6216\u6b63\u5728\u8fdb\u884c\u7684\u8463\u4e8b\u4f1a\u8c03\u67e5\u4f5c\u51fa\u56de\u5e94\uff0c\u4e5f\u4e0d\u63a5\u53d7\u4efb\u4f55\u76f8\u5173\u63d0\u95ee\u3002\n\n\u4e8c\u3001\u4e1a\u52a1\u8fde\u7eed\u6027\u4e0e\u8d22\u52a1\u5c55\u671b\n\n1\u3001\u4e34\u65f6CEO\u517cCFO\u79d1\u83b1\u7279\u00b7\u514b\u96f7\u65af\uff08Colette Kress\uff09\u8868\u793a\uff0c\u5f3a\u52b2\u7684\u8425\u6536\u4e0e\u589e\u957f\u6307\u5f15\uff1a \u82f1\u4f1f\u8fbe\u516c\u5e03\u7b2c\u4e09\u5b63\u5ea6\u8425\u6536\u8fbe 1,158 \u4ebf\u7f8e\u5143\uff0c\u5e76\u9884\u8ba1\u7b2c\u56db\u5b63\u5ea6\u8425\u6536\u5c06\u8fbe\u5230 1,300 \u4ebf\u7f8e\u5143\uff08\u6307\u5f15\u533a\u95f4\u4e3a 1,274 \u4ebf\u81f3 1,326 \u4ebf\u7f8e\u5143\uff09\uff0c\u6bdb\u5229\u7387\u9884\u8ba1\u5728 71% \u81f3 72% \u4e4b\u95f4\u3002\u514b\u96f7\u65af\u5c06 2028 \u8d22\u5e74\u7684\u8425\u6536\u589e\u957f\u9884\u671f\u4ece 70% \u4e0a\u8c03\u81f3 75%\uff0c\u5e76\u5c06\u5176\u5f52\u56e0\u4e8e\u6301\u7eed\u65fa\u76db\u7684\u5e02\u573a\u9700\u6c42\u4ee5\u53ca\u4f9b\u5e94\u80fd\u529b\u7684\u6539\u5584\u3002\n\n2\u3001\u201c\u4e1a\u52a1\u4e00\u5207\u7167\u5e38\u201d\uff1a \u514b\u96f7\u65af\u5411\u6295\u8d44\u8005\u548c\u5458\u5de5\u4fdd\u8bc1\uff0c\u516c\u53f8\u5185\u90e8\u201c\u4e1a\u52a1\u4e00\u5207\u7167\u5e38\u201d\uff0c\u8868\u793a\u82f1\u4f1f\u8fbe\u7ba1\u7406\u5c42\u7ecf\u53d7\u4f4f\u4e86\u8003\u9a8c\uff0c\u4e14\u201c\u6211\u4eec\u5bf9\u521b\u65b0\u7684\u70ed\u60c5\u4e0d\u4f1a\u6539\u53d8\uff0c\u5bf9\u5ba2\u6237\u3001\u5408\u4f5c\u4f19\u4f34\u548c\u80a1\u4e1c\u7684\u627f\u8bfa\u4e5f\u4e0d\u4f1a\u6539\u53d8\u201d\u3002\u5979\u8fd8\u63d0\u5230\uff0c\u88ab\u89c6\u4e3a\u5185\u90e8 CEO \u5019\u9009\u4eba\u7684\u6570\u636e\u4e2d\u5fc3\u4e1a\u52a1\u8d1f\u8d23\u4eba\u4f0a\u6069\u00b7\u5df4\u514b\u4e5f\u4e00\u540c\u51fa\u5e2d\u4e86\u5206\u6790\u5e08\u95ee\u7b54\u73af\u8282\u3002","multimedia":"","commentid":"live:finance-152-5221040:0","compere_id":0,"creator":"yongsheng6@staff.sina.com.cn","mender":"yongsheng6@staff.sina.com.cn","create_time":"2026-11-18 07:06:57","update_time":"2026-11-18 07:42:14","is_need_check":"0","check_time":"1970-01-01 08:00:01","check_status":"1","check_user":"","is_delete":0,"top_value":0,"is_focus":0,"source_content_id":"0","anchor_image_url":"","anchor":"","ex