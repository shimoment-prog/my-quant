\u8bc11000\u589e\u5f3aETF\u62db\u5546\u7684\u9009\u80a1\u7b54\u6848\uff1a\u57fa\u672c\u9762\u7b5b\u9009\u51fa\u4f30\u503c\u66f4\u4f4e\u3001\u76c8\u5229\u66f4\u5f3a\u516c\u53f8\u3011A\u80a1\u7ed3\u6784\u6027\u884c\u60c5\u6301\u7eed\u6f14\u7ece\uff0c\u90e8\u5206\u6307\u589eETF\u51ed\u501f\u6301\u7eed\u8d85\u989d\u8868\u73b0\uff0c\u53d7\u5230\u5e02\u573a\u8d44\u91d1\u5173\u6ce8\u3002\u57fa\u91d1\u5b9a\u671f\u62a5\u544a\u663e\u793a\uff0c\u622a\u81f32026\u5e749\u670830\u65e5\uff0c\u4e2d\u8bc11000\u589e\u5f3aETF\u62db\u5546\uff08159680\uff09\u81ea\u6210\u7acb\u4ee5\u6765\u7d2f\u8ba1\u51c0\u503c\u589e\u957f59.67%\uff0c\u7d2f\u8ba1\u8d85\u989d\u6536\u76ca50.97%\uff0c\u6298\u5408\u5e74\u5316\u8d85\u989d\u6536\u76ca10.67%\u3002\u5206\u9636\u6bb5\u7edf\u8ba1\uff0c\u6210\u7acb\u4ee5\u6765\u6bcf\u534a\u5e74\u8be5ETF\u5747\u53d6\u5f97\u6b63\u8d85\u989d\u6536\u76ca\uff0c\u4ea7\u54c1\u7684\u8d85\u989d\u83b7\u53d6\u5e76\u975e\u4f9d\u8d56\u67d0\u4e00\u9636\u6bb5\u7684\u884c\u60c5\u7206\u53d1\u3002\u7a7f\u900f\u8be5ETF\u7533\u8d4e\uff08PCF\uff09\u6e05\u5355\u4f1a\u53d1\u73b0\uff0c\u5176\u8d85\u989d\u6765\u6e90\u66f4\u591a\u6765\u81ea\u4e2a\u80a1\u57fa\u672c\u9762\u7684\u7b5b\u9009\u4e0a\uff0c\u800c\u975e\u62bc\u6ce8\u5355\u4e00\u8d5b\u9053\u3002\u6570\u636e\u663e\u793a\uff0c\u622a\u81f32026\u5e7410\u6708\u5e95\uff0c\u76f8\u5bf9\u57fa\u51c6\u6307\u6570\uff0c\u4e2d\u8bc11000\u589e\u5f3aETF\u62db\u5546\u6301\u4ed3\u7ec4\u5408\u5448\u73b0\u201c\u4f30\u503c\u66f4\u4f4e\u3001\u6210\u957f\u66f4\u5feb\u3001\u76c8\u5229\u66f4\u5f3a\u201d\u7684\u7279\u70b9\u3002\u884c\u4e1a\u5c42\u9762\uff0c\u76f8\u5bf9\u57fa\u51c6\u6307\u6570\uff0c\u8be5ETF\u6301\u4ed3\u7ec4\u5408\u7565\u5411\u786c\u79d1\u6280\u4e0e\u9ad8\u7aef\u5236\u9020\u65b9\u5411\u503e\u659c\uff0c\u8d85\u914d\u7535\u529b\u8bbe\u5907\u3001\u7535\u5b50\u3001\u8ba1\u7b97\u673a\uff0c\u4f4e\u914d\u57fa\u7840\u5316\u5de5\u3001\u975e\u94f6\u91d1\u878d\u3001\u94f6\u884c\u7b49\u3002\u8fd9\u79cd\u56f4\u7ed5\u624e\u5b9e\u57fa\u672c\u9762\u6784\u5efa