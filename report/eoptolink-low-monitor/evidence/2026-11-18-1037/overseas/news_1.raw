\u5f53\u524d\u5c9b\u5185\u6587\u5316\u751f\u6001\u88ab\u201c\u53f0\u72ec\u201d\u52bf\u529b\u653f\u6cbb\u88f9\u631f\u8868\u8fbe\u6df1\u5207\u5fe7\u8651\u3002\u4ed6\u6307\u51fa\uff0c\u4e2d\u534e\u6587\u660e\u7684\u535a\u5927\u6c14\u8c61\uff0c\u5f97\u76ca\u4e8e\u4e2d\u534e\u6587\u5316\u81ea\u53e4\u4ee5\u6765\u5f00\u653e\u7684\u59ff\u6001\u3001\u5305\u5bb9\u7684\u80f8\u6000\u3002\u6c11\u8fdb\u515a\u5f53\u5c40\u4e3a\u4e86\u653f\u6cbb\u79c1\u5229\u5927\u8086\u63a8\u8fdb\u201c\u6587\u5316\u53f0\u72ec\u201d\uff0c\u5236\u9020\u201c\u7eff\u8272\u6050\u6016\u201d\u201c\u5bd2\u8749\u6548\u5e94\u201d\uff0c\u5df2\u7ecf\u5230\u4e86\u53f0\u6e7e\u6c11\u4f17\u5fc3\u751f\u6050\u60e7\u7684\u5730\u6b65\uff0c\u4e25\u91cd\u635f\u5bb3\u53f0\u6e7e\u540c\u80de\u7684\u5207\u8eab\u5229\u76ca\uff0c\u6fc0\u8d77\u53f0\u6e7e\u6c11\u4f17\u7684\u5f3a\u70c8\u4e0d\u6ee1\u548c\u666e\u904d\u53cd\u5bf9\u3002","multimedia":"","commentid":"live:finance-152-5221590:0","compere_id":0,"creator":"yujian@staff.sina.com.cn","mender":"yujian@staff.sina.com.cn","create_time":"2026-11-18 10:34:33","update_time":"2026-11-18 10:34:33","is_need_check":"0","check_time":"1970-01-01 08:00:01","check_status":"1","check_user":"","is_delete":0,"top_value":0,"is_focus":0,"source_content_id":"0","anchor_image_url":"","anchor":"","ext":"{\"stocks\":[],\"needPushWB\":false,\"needCMSLink\":true,\"needCalender\":false,\"terms\":[],\"docurl\":\"https:\\\/\\\/finance.sina.com.cn\\\/7x24\\\/2026-11-18\\\/doc-inizcmfi4924705.shtml\",\"docid\":\"nizcmfi4924705\"}","old_live_cid":"0","tab":"","is_repeat":"0","tag":[{"id":"1","name":"\u5b8f\u89c2"}],"like_nums":0,"comment_list":{"list":[],"total":0,"thread_show":0,"qreply":0,"qreply_show":0,"show":0},"docurl":"https:\/\/finance.sina.cn\/7x24\/2026-11-18\/detail-inizcmfi4924705.d.html","rich_text_nick_to_url":[],"rich_text_nick_to_routeUri":[],"compere_info":""},{"id":5221585,"zhibo_id":152,"type":0,"rich_text":"\u3010\u5929\u5b5a\u901a\u4fe1\u4e0e\u542f\u8fea\u8bbe\u8ba1\u7b7e\u7f72\u6218\u7565\u5408\u4f5c\u534f\u8bae\u301111\u670817\u65e5\uff0c\u5929\u5b5a\u901a\u4fe1\u4e0e\u542f\u8fea\u8bbe\u8ba1\u4e3e\u884c\u6218\u7565\u5408\u4f5c\u534f\u8bae\u7b7e\u7f72\u4eea\u5f0f\uff0c\u6807\u5fd7\u7740\u53cc\u65b9\u6b63\u5f0f\u5efa\u7acb\u5168\u65b9\u4f4d\u3001\u6df1\u5c42\u6b21\u7684\u6218\u7565\u5408\u4f5c\u4f19\u4f34\u5173\u7cfb\u3002","multimedia":"","commentid":"live:finance-152-5221585:0","compere_id":0,"creator":"yujian@staff.sina.com.cn","mender":"yujian@staff.sina.com.cn","create_time":"2026-11-18 10:33:42","update_time":"2026-11-18 10:33:42","is_need_check":"0","check_time":"1970-01-01 08:00:01","check_status":"1","check_user":"","is_delete":0,"top_value":0,"is_focus":0,"source_content_id":"0","anchor_image_url":"","anchor":"","ext":"{\"stocks\":[],\"needPushWB\":false,\"needCMSLink\":true,\"needCalender\":false,\"terms\":[],\"docurl\":\"https:\\\/\\\/finance.sina.com.cn\\\/7x24\\\/2026-11-18\\\/doc-inizcmfi4924116.shtml\",\"docid\":\"nizcmfi4924116\"}","old_live_cid":"0","tab":"","is_repeat":"0","tag":[{"id":"8","name":"\u5176\u4ed6"}],"like_nums":0,"comment_list":{"list":[],"total":0,"thread_show":0,"qreply":0,"qreply_show":0,"show":0},"docurl":"https:\/\/finance.sina.cn\/7x24\/2026-11-18\/detail-inizcmfi4924116.d.html","rich_text_nick_to_url":[],"rich_text_nick_to_routeUri":[],"compere_info":""},{"id":5221580,"zhibo_id":152,"type":0,"rich_text":"\u4e59\u4e8c\u9187\u8fde\u7eed\u4e3b\u529b\u5408\u7ea6\u65e5\u5185\u8dcc3%\uff0c\u73b0\u62a54969.00\u5143\u3002","multimedia":"","commentid":"live:finance-152-5221580:0","compere_id":0,"creator":"data_auto@staff.sina.com.cn","mender":"","create_time":"2026-11-18 10:33:08","update_time":"2026-11-18 10:33:27","is_need_check":"0","check_time":"1970-01-01 08:00:01","check_status":"1","check_user":"","is_delete":0,"top_value":0,"is_focus":0,"source_content_id":"0","anchor_image_url":"","anchor":"","ext":"{\"docurl\":\"https:\\\/\\\/finance.sina.com.cn\\\/7x24\\\/2026-11-18\\\/doc-inizcmfi4923579.shtml\",\"do