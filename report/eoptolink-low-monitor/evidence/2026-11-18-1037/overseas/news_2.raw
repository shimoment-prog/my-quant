9152\u4e1a12\u5927\u5355\u54c1\u7684\u7ec8\u7aef\u96f6\u552e\u5747\u4ef7\u4e24\u6da8\u4e5d\u8dcc\u4e00\u5e73\uff0c\u4e0b\u8dcc\u9152\u54c1\u7684\u6570\u91cf\u5360\u636e\u538b\u5012\u6027\u4f18\u52bf\uff0c\u7d2f\u8ba1\u8dcc\u5e45\u4e5f\u660e\u663e\u8d85\u8fc7\u4e0a\u6da8\u7aef\uff0c\u6574\u4f53\u4ef7\u76d8\u8fde\u7eed\u4e09\u5929\u4e0b\u8dcc\u5e76\u521b\u4e0b\u9636\u6bb5\u6027\u65b0\u4f4e\u3002\u4e0a\u6da8\u7aef\uff0c\u6d0b\u6cb3\u68a6\u4e4b\u84ddM6+\u4e0a\u6da81\u5143\u81f3593\u5143\uff0c\u524d\u671f\u5de8\u5e45\u632f\u8361\u540e\u6b65\u5165\u7a84\u5e45\u6574\u7406\uff1b\u4e60\u9152\u541b\u54c1\u4e0a\u6da84\u5143\u81f3618\u5143\uff0c\u6628\u65e5\u5927\u8dcc\u540e\u8fc5\u901f\u56de\u5f39\uff0c\u6536\u590d\u5927\u90e8\u5206\u5931\u5730\u3002\u4e0b\u8dcc\u7aef\uff0c\u98de\u5929\u8305\u53f0\u7684\u96f6\u552e\u5747\u4ef7\u4e0b\u8dcc3\u5143\u81f31761\u5143\uff0c\u8fde\u7eed\u4e09\u5929\u5c0f\u5e45\u56de\u8c03\uff0c\u521b\u4e0b\u8fd130\u5929\u65b0\u4f4e\uff1b\u7cbe\u54c1\u8305\u53f0\u4e0b\u8dcc4\u5143\u81f32401\u5143\uff0c\u4ea6\u662f\u8fde\u7eed\u4e09\u5929\u8d70\u4f4e\uff0c\u6765\u5230\u8fc7\u53bb\u4e00\u4e2a\u6708\u6700\u4f4e\u70b9\uff0c\u8fd1\u671f\u5176\u4ef7\u683c\u8fc5\u901f\u5411i\u8305\u53f0\u5e73\u53f0\u653e\u91cf\u6295\u653e\u7684\u5b9a\u4ef72359\u5143\u9760\u62e2\uff1b\u8305\u53f01935\u4e0b\u8dcc2\u5143\u81f3684\u5143\uff0c\u8fde\u7eed\u7b2c\u4e8c\u5929\u5c0f\u5e45\u4e0b\u884c\uff1b\u4e94\u7cae\u6db2\u666e\u4e94\u516b\u4ee3\u4e0b\u8dcc5\u5143\u81f3783\u5143\uff0c\u8fde\u7eed\u4e24\u5929\u5927\u5e45\u4e0b\u632b\u4e14\u91cf\u80fd\u8f83\u5927\uff1b\u4e94\u7cae\u6db21618\u4e0b\u8dcc3\u5143\u81f3818\u5143\uff0c\u4e8c\u8fde\u9634\u8dcc\u7834820\u4e00\u7ebf\uff1b\u9752\u82b1\u6c7e20\u4e0b\u8dcc2\u5143\u81f3378\u5143\uff0c\u8fde\u7eed\u7b2c\u4e09\u5929\u4e0b\u8dcc\uff0c\u91cd\u8fd4\u8fd130\u5929\u4f4e\u4f4d\u533a\u95f4\uff1b\u56fd\u7a961573\u4e0b\u8dcc2\u5143\u81f3860\u5143\uff0c\u6628\u65e5\u5f3a\u529b\u53cd\u5f39\u8fc5\u901f\u7ec8\u7ed3\uff1b\u9752\u82b1\u90ce\u4e0b\u8dcc3\u5143\u81f3665\u5143\uff0c\u4ea6\u4e3a\u6628\u65e5\u5927\u6da8\u540e\u65cb\u5373\u56de\u8c03\uff0c\u91cd\u8fd4\u8fd1\u671f\u4e0b\u884c\u8d8b\u52bf\u8f68\u9053\uff1b\u6c34\u6676\u5251\u5357\u6625\u5c0f\u8dcc1\u5143\u81f3402\u5143\uff0c\u8fd1\u671f\u6301\u7eed\u5c0f\u6da8\u6216\u5e73\u76d8\u540e\u5f00\u59cb\u56de\u843d\u3002\u6301\u5e73\u65b9\u9762\uff0c\u53e4\u4e95\u8d21\u53e420\u7ef4\u6301\u5728519\u5143\uff0c\u6628\u5929\u5927\u5e45\u4e0b\u8dcc\u540e\u6682\u4e8b\u4f11\u6574\u3002\n\n\u4eca\u65e512\u5927\u5355\u54c1\u7684\u7ec8\u7aef\u96f6\u552e\u603b\u4ef7\u8fde\u7eed\u7b2c\u4e09\u5929\u8d70\u4f4e\uff0c\u4e94\u7cae\u6db2\u666e\u4e94\u516b\u4ee3\u3001\u4e94\u7cae\u6db21618\u3001\u7cbe\u54c1\u8305\u53f0\u3001\u9752\u82b1\u90ce\u7684\u8dcc\u5e45\u8f83\u91cd\uff0c\u538b\u5236\u6574\u4f53\u4ef7\u76d8\u5927\u5e45\u4e0b\u6ed1\u3002\u5982\u679c12\u5927\u5355\u54c1\u5404\u53d6\u4e00\u74f6\u6574\u4f53\u6253\u5305\u552e\u5356\uff0c\u4eca\u65e5\u603b\u552e\u4ef7\u4e3a10482\u5143\uff0c\u8f83\u6628\u65e5\u4e0b\u8dcc20\u5143\uff0c\u521b\u4e0b\u516d\u5929\u4ee5\u6765\u65b0\u4f4e\uff0c10500\u5173\u53e3\u4e00\u65e5\u5373\u544a\u7834\u3002","multimedia":{"img_url":["https:\/\/n.sinaimg.cn\/zhibo\/515\/w750h2165\/20261118\/04e3-b6bd69b529ed098393c04c3c189ee44c.jpg"]},"commentid":"live:finance-152-5221176:0","compere_id":0,"creator":"yongsheng6@staff.sina.com.cn","mender":"yongsheng6@staff.sina.com.cn","create_time":"2026-11-18 08:57:51","update_time":"2026-11-18 08:57:51","is_need_check":"1","check_time":"2026-11-18 08:57:55","check_status":"1","check_user":"yongsheng6@staff.sina.com.cn","is_delete":0,"top_value":0,"is_focus":0,"source_content_id":"0","anchor_image_url":"","anchor":"","ext":"{\"stocks\":[{\"market\":\"cn\",\"symbol\":\"sh600519\",\"key\":\"\\u8305\\u53f0\"},{\"market\":\"cn\",\"symbol\":\"sz000858\",\"key\":\"\\u4e94\\u7cae\\u6db2\"},{\"market\":\"cn\",\"symbol\":\"sz002304\",\"key\":\"\\u6d0b\\u6cb3\"},{\"market\":\"cn\",\"symbol\":\"sz000596\",\"key\":\"\\u53e4\\u4e95\\u8d21\"}],\"needPushWB\":false,\"needCMSLink\":true,\"needCalender\":false,\"terms\":[],\"docurl\":\"https:\\\/\\\/finance.sina.com.cn\\\/7x24\\\/2026-11-18\\\/doc-inizcexp1748410.shtml\",\"docid\":\"nizcexp1748410\"}","old_live_cid":"0","tab":"","is_repeat":"0","tag":[{"id":"5","name":"\u5e02\u573a"}],"like_nums":0,"comment_list":{"list":[],"total":0,"thread_show":0,"qreply":0,"qreply_show":0,"show":0},"docurl":"https:\/\/finance.sina.cn\/7x24\/2026-11-18\/detail-inizcexp1748410.d.html","rich_text_nick_to_url":[],"rich_text_nick_to_routeUri":[],"compere_info":""},{"id":5221175,"zhibo_id":152,"type":0,"rich_text":"\u3010\u878d\u901a\u4e9a\u592a \u5171\u4fc3\u7e41\u8363\uff01\u201cAPEC\u8d22\u7ecf\u4e4b\u591c\u201d\u5728\u6df1\u5733\u4e3e\u529e\u301111\u670817\u65e5\uff0c\u7531\u4e2d\u592e\u5e7f\u64ad\u7535\u89c6\u603b\u53f0\u8d22\u7ecf\u8282\u76ee\u4e2d\u5fc3\u4e3b\u529e\u7684\u201cAPEC\u8d22\u7ecf\u4e4b\u591c\u201d\u5728\u6df1\u5733\u542f\u5e55\u3002\u767e\u4f59\u4f4d\u4e2d\u5916\u5de5\u5546\u754c\u4ee3\u8868\u3001\u7ecf\u6d4e\u5b66\u5bb6\uff0c\u805a\u7126\u4e9a\u592a\u7ecf\u6d4e\u4f53\u4e92\u5229\u5171\u751f\u7684\u751f\u52a8\u5b9e\u8df5\uff0c\u5168\u65b9\u4f4d\u5c55\u73b0\u4e9a\u592a\u533a\u57df\u4ea7\u4e1a\u878d\u901a\u3001\u534f\u540c\u521b\u65b0\u3001\u5e02\u573a\u4e92\u8054\u3001\u9646\u6d77\u8054\u901a\u7684\u84ec\u52c3\u52a8\u80fd\u3002\u4e2d\u56fd\u6838\u5de5\u4e1a\u96c6\u56e2\u6709\u9650\u516c\u53f8\u8463\u4e8b\u957f\u7533\u5f66\u950b\uff0c\u4e2d\u56fd\u4e2d\u8f66\u96c6\u56e2\u6709\u9650\u516c\u53f8\u8463\u4e8b\u957f\u5b59\u6c38\u624d\uff0c\u4e2d\u56fd\u94c1\u9053\u5efa\u7b51\u96c6\u56e2\u6709\u9650\u516c\u53f8\u8463\u4e8b\u957f\u6234\u548c\u6839\uff0c\u4e2d\u56fd\u7269\u6d41\u96c6\u56e2\u6709\u9650\u516c\u53f8\u8463\u4e8b\u957f\u5218\u656c\u6862\uff0c\u5e73\u9646\u8fd0\u6cb3\u96c6\u56e2\u6709\u9650\u516c\u53f8\u603b\u7ecf\u7406\u5434\u677e\uff0c\u6c88\u9f13\u96c6\u56e2\u80a1\u4efd\u6709\u9650\u516c\u53f8\u8463\u4e8b\u957f\u6234\u7ee7\u53cc\uff0c\u73e0\u6d77\u683c\u529b\u7535\u5668\u80a1\u4efd\u6709\u9650\u516c\u53f8\u8463\u4e8b\u957f\u8463\u660e\u73e0\uff0c\u9ed1\u9f99\u6c5f\u98de\u9e64\u4e73\u4e1a\u6709\u9650\u516c\u53f8\u8463\u4e8b\u957f\u51b7\u53cb\u658c\uff0c\u534f\u946b\uff08\u96c6\u56e2\uff09\u63a7\u80a1\u6709\u9650\u516c\u53f8\u521b\u59cb\u4eba\u6731\u5171\u5c71\uff0c\u5b87\u6811\u79d1\u6280\u80a1\u4efd\u6709\u9650\u516c\u53f8\u521b\u59cb\u4eba\u738b\u5174\u5174\uff0c\u6b23\u65fa\u8fbe\u7535\u5b50\u80a1\u4efd\u6709\u9650\u516c\u53f8\u521b\u59cb\u4eba\u738b\u660e\u65fa\uff0c\u5e7f\u4e1c\u9886\u76ca\u667a\u9020\u80a1\u4efd\u6709\u9650\u516c\u53f8\u8463\u4e8b\u957f\u66fe\u82b3\u52e4\uff0c\u957f\u98de\u5149\u7ea4\u5149\u7f06\u80a1\u4efd\u6709\u9650\u516c\u53f8\u603b\u88c1\u5e84\u4e39\uff0c\u5317\u4eac\u661f\u52a8\u7eaa\u5143\u79d1\u6280\u80a1\u4efd\u6709\u9650\u516c\u53f8\u521b\u59cb\u4eba\u9648\u5efa\u5b87\uff0c\u667a\u5143\u521b\u65b0\uff08\u4e0a\u6d77\uff09\u79d1\u6280\u80a1\u4efd\u6709\u9650\u516c\u53f8\u5408\u4f19\u4eba\u738b\u95ef\uff0c\u5f3a\u8111\u79d1\u6280\u80a1\u4efd\u6709\u9650\u516c\u53f8\u521b\u59cb\u4eba\u97e9\u74a7\u4e1e\uff0c\u6df1\u5733\u4f17\u64ce\u673a\u5668\u4eba\u79d1\u6280\u80a1\u4efd\u6709\u9650\u516c\u53f8\u521b\u59cb\u4eba\u8d75\u540c\u9633\uff0c\u6df1\u5733\u4e91\u8c79\u667a\u80fd\u80a1\u4efd\u6709\u9650\u516c\u53f8\u8463\u4e8b\u957f\u8427\u542f\u9633\uff0c\u5149\u8f6e\u667a\u80fd\uff08\u5317\u4eac\uff09\u79d1\u6280\u80a1\u4efd\u6709\u9650\u516c\u53f8\u521b\u59cb\u4eba\u8c22\u6668\uff0c\u4e50\u805a\u667a\u80fd\uff08\u6df1\u5733\uff09\u80a1\u4efd\u6709\u9650\u516c\u53f8\u8054\u5408\u521b\u59cb\u4eba\u5e38\u7433\uff0c\u6d59\u6c5f\u6d77\u6b63\u836f\u4e1a\u80a1\u4efd\u6709\u9650\u516c\u53f8\u8463\u4e8b\u957f\u8096\u536b\u7ea2\uff0c\u6df1\u5733\u5e02\u6d32\u660e\u79d1\u6280\u80a1\u4efd\u6709\u9650\u516c\u53f8\u8463\u4e8b\u957f\u6797\u6d3a\u950b\uff0c\u5317\u4eac\u6d2a\u6cf0\u540c\u521b\u6295\u8d44\u7ba1\u7406\u6709\u9650\u516c\u53f8\u8463\u4e8b\u957f\u76db\u5e0c\u6cf0\uff0c\u534e\u76d6\u8d44\u672c\u6709\u9650\u8d23\u4efb\u516c\u53f8\u8463\u4e8b\u957f\u8bb8\u5c0f\u6797\uff0c\u84dd\u7bad\u822a\u5929\u7a7a\u95f4\u79d1\u6280\u80a1\u4efd\u6709\u9650\u516c\u53f8\u526f\u603b\u88c1\u5f20\u9759\u8339\uff0c\u4e2d\u56fd\u8239\u8236\u5de5\u4e1a\u884c\u4e1a\u534f\u4f1a\u526f\u4f1a\u957f\u674e\u5f66\u5e86\uff0c\u6df1\u5733\u5e02\u9f99\u5c97\u533a\u653f\u5e9c\u526f\u533a\u957f\u5f90\u7ea2\u4e3d\uff0c\u6df1\u5733\u5e02\u9f99\u5c97\u533a\u4eba\u5de5\u667a\u80fd\uff08\u673a\u5668\u4eba\uff09\u7f72\u7f72\u957f\u8d75\u51b0\u51b0\uff0c\u534e\u4e1c\u5e08\u8303\u5927\u5b66\u4e0a\u6d77\u4eba\u5de5\u667a\u80fd\u91d1\u878d\u5b66\u9662\u9662\u957f\u90b5\u6021\u857e\uff0c\u6fb3\u5927\u5229\u4e9a\u4e2d\u56fd\u5de5\u5546\u4e1a\u59d4\u5458\u4f1a\u5168\u56fd\u4e3b\u5e2d\u517c\u4f1a\u957fRhys Roberts\uff0c\u52a0\u62ff\u5927\u5546\u4e1a\u7406\u4e8b\u4f1a\u4e3b\u5e2d\u517cCEO\u6208\u5c14\u8fea\u30fb\u6d77\u5fb7\uff0c\u9a6c\u6765\u897f\u4e9a-\u4e2d\u56fd\u5546\u52a1\u7406\u4e8b\u4f1a\u4e3b\u5e2d\u5362\u6210\u5168\uff0c\u5b89\u5229\uff08\u4e2d\u56fd\uff09\u65e5\u7528\u54c1\u6709\u9650\u516c\u53f8\u8463\u4e8b\u957f\u4f59\u653e\uff0c\u6469\u6839\u5927\u901a\u4e2d\u56fd\u533a\u8054\u5e2d\u9996\u5e2d\u6267\u884c\u5b98\u4f55\u8000\u4e1c\u53ca\u603b\u53f0\u76f8\u5173\u90e8\u95e8\u8d1f\u8d23\u4eba\uff0c\u56fd\u5185\u5916\u4f01\u4e1a\u5bb6\u4ee3\u8868\u548c\u5916\u5546\u534f\u4f1a\u8d1f\u8d23\u4eba\u7b49500\u4f59\u4eba\u51fa\u5e2d\u6d3b\u52a8\u3002\uff08\u592e\u89c6\uff09","multimedia":"","commentid":"live:finance-152-5221175:0","compere_id":0,"creator":"yongsheng6@staff.sina.com.cn","mender":"yongsheng6@staff.sina.com.cn","create_time":"2026-11-18 08:57:06","update_time":"2026-11-18 08:57:06","is_need_check":"1","check_time":"2026-11-18 08:57:09","check_status":"1","check_user":"yongsheng6@staff.sina.com.cn","is_delete":0,"top_value":0,"is_focus":0,"source_content_id":"0","anchor_image_url":"","anchor":"","ext":"{\"stocks\":[],\"needPushWB\":false,\"needCMSLink\":true,\"needCalender\