],"like_nums":0,"comment_list":{"list":[],"total":0,"thread_show":0,"qreply":0,"qreply_show":0,"show":0},"docurl":"https:\/\/finance.sina.cn\/7x24\/2026-11-17\/detail-iniyyzyi1905947.d.html","rich_text_nick_to_url":[],"rich_text_nick_to_routeUri":[],"compere_info":""},{"id":5218974,"zhibo_id":152,"type":0,"rich_text":"\u622a\u81f3\u65e9\u76d8\u6536\u76d8\uff0c\u65e5\u7ecf225\u6307\u6570\u3001\u4e1c\u8bc1\u6307\u6570\u5747\u8dcc1.2%\u3002","multimedia":"","commentid":"live:finance-152-5218974:0","compere_id":0,"creator":"yujian@staff.sina.com.cn","mender":"yujian@staff.sina.com.cn","create_time":"2026-11-17 10:32:12","update_time":"2026-11-17 10:32:12","is_need_check":"0","check_time":"1970-01-01 08:00:01","check_status":"1","check_user":"","is_delete":0,"top_value":0,"is_focus":0,"source_content_id":"0","anchor_image_url":"","anchor":"","ext":"{\"stocks\":[{\"market\":\"worldIndex\",\"symbol\":\"znb_nky\",\"key\":\"\\u65e5\\u7ecf225\\u6307\\u6570\"},{\"market\":\"fund\",\"symbol\":\"159352\",\"key\":\"\\u6307\\u6570\",\"sym_party_status\":\"1\"}],\"needPushWB\":false,\"needCMSLink\":true,\"needCalender\":false,\"terms\":[],\"docurl\":\"https:\\\/\\\/finance.sina.com.cn\\\/7x24\\\/2026-11-17\\\/doc-iniyyzyp7789090.shtml\",\"docid\":\"niyyzyp7789090\"}","old_live_cid":"0","tab":"","is_repeat":"0","tag":[{"id":"5","name":"\u5e02\u573a"}],"like_nums":0,"comment_list":{"list":[],"total":0,"thread_show":0,"qreply":0,"qreply_show":0,"show":0},"docurl":"https:\/\/finance.sina.cn\/7x24\/2026-11-17\/detail-iniyyzyp7789090.d.html","rich_text_nick_to_url":[],"rich_text_nick_to_routeUri":[],"compere_info":""},{"id":5218973,"zhibo_id":152,"type":0,"rich_text":"\u3010APEC\u201c\u4e2d\u56fd\u5e74\u201d\u4e00\u7cfb\u5217\u4f1a\u8bae\u548c\u6d3b\u52a8\u53d6\u5f97\u4e30\u7855\u6210\u679c\u3011\u4eca\u5929\uff0817\u65e5\uff09\u4e0a\u5348\uff0c2026\u5e74APEC\u9886\u5bfc\u4eba\u4f1a\u8bae\u5468\u65b0\u95fb\u4e2d\u5fc3\u4e3e\u529e\u7b2c\u4e94\u573a\u5439\u98ce\u4f1a\uff0c2026\u5e74APEC\u9ad8\u5b98\u4f1a\u4e3b\u5e2d\u9648\u65ed\u5728\u5439\u98ce\u4f1a\u4e0a\u4ecb\u7ecd\uff0c\u9ad8\u5b98\u4f1a\u662f\u63a8\u8fdbAPEC\u5408\u4f5c\u3001\u915d\u917f\u9886\u5bfc\u4eba\u975e\u6b63\u5f0f\u4f1a\u8bae\u6210\u679c\u7684\u91cd\u8981\u6e20\u9053\u3002APEC\u201c\u4e2d\u56fd\u5e74\u201d\u4ee5\u6765\uff0c\u4e2d\u65b9\u5148\u540e\u5728\u6df1\u5733\u3001\u5e7f\u5dde\u3001\u4e0a\u6d77\u3001\u5927\u8fde\u4e3e\u529e\u4e86\u975e\u6b63\u5f0f\u9ad8\u5b98\u4f1a\u4ee5\u53ca\u7b2c\u4e00\u3001\u4e8c\u3001\u4e09\u6b21\u9ad8\u5b98\u4f1a\u548c\u76f8\u5173\u4f1a\u8bae\uff0c\u6700\u540e\u4e00\u6b21\u9ad8\u5b98\u4f1a\u4e5f\u521a\u521a\u5728\u6df1\u5733\u987a\u5229\u7ed3\u675f\u3002\u8fd9\u4e9b\u4f1a\u8bae\u548c\u6d3b\u52a8\u6709\u529b\u652f\u6491\u548c\u4fc3\u8fdb\u4e86APEC\u201c\u4e2d\u56fd\u5e74\u201d\u5408\u4f5c\uff0c\u4e3a\u9886\u5bfc\u4eba\u975e\u6b63\u5f0f\u4f1a\u8bae\u5960\u5b9a\u4e86\u575a\u5b9e\u57fa\u7840\u3002\u4e2d\u65b9\u8fd8\u5728\u4e0a\u6d77\u3001\u82cf\u5dde\u3001\u6fb3\u95e8\u3001\u6df1\u5733\u3001\u676d\u5dde\u3001\u5e7f\u5dde\u3001\u5317\u4eac\u3001\u5357\u4eac\u3001\u9999\u6e2f\u3001\u6210\u90fd\u7b49\u5730\u4e3e\u529e\u4e86\u5987\u5973\u3001\u8d38\u6613\u3001\u65c5\u6e38\u3001\u6797\u4e1a\u3001\u7cae\u98df\u5b89\u5168\u3001\u4e2d\u5c0f\u4f01\u4e1a\u3001\u80fd\u6e90\u3001\u4eba\u529b\u8d44\u6e90\u5f00\u53d1\u3001\u4ea4\u901a\u3001\u8d22\u653f\u7b4910\u573a\u4e13\u4e1a\u90e8\u957f\u4f1a\u548cAPEC\u6570\u5b57\u5468\u7cfb\u5217\u6d3b\u52a8\uff0c\u53d6\u5f97\u4e86\u4e30\u7855\u6210\u679c\u3002\u5728\u8d38\u6613\u9886\u57df\uff0c\u5404\u65b9\u56f4\u7ed5\u63a8\u52a8\u533a\u57df\u7ecf\u6d4e\u4e00\u4f53\u5316\u548c\u4e9a\u592a\u81ea\u8d38\u533a\u5efa\u8bbe\u3001\u652f\u6301\u4e16\u8d38\u7ec4\u7ec7\u3001\u4fc3\u8fdb\u6570\u5b57\u5408\u4f5c\u3001\u53d1\u5c55\u7eff\u8272\u7ecf\u6d4e\u7b49\u9886\u57df\u6df1\u5165\u5c55\u5f00\u8ba8\u8bba\uff0c\u91cd\u7533\u652f\u6301\u4e9a\u592a\u81ea\u8d38\u533a\u8fdb\u7a0b\uff0c\u6279\u51c6\u4e86\u300aAPEC\u521b\u65b0\u3001\u6709\u7ade\u4e89\u529b\u548c\u97e7\u6027\u7684\u670d\u52a1\u4e1a\u8def\u7ebf\u56fe\u300b\u3002\u5728\u6570\u5b57\u548c\u4eba\u5de5\u667a\u80fd\u9886\u57df\uff0c\u5404\u65b9\u56f4\u7ed5\u6570\u667a\u8d4b\u80fd\u7ecf\u6d4e\u589e\u957f\u3001\u6570\u5b57\u4e92\u8054\u4e92\u901a\u4ee5\u53ca\u4eba\u5de5\u667a\u80fd\u5b89\u5168\u90e8\u7f72\u548c\u8d1f\u8d23\u4efb\u5e94\u7528\u7b49\u8fbe\u6210\u4e00\u7cfb\u5217\u91cd\u8981\u5171\u8bc6\uff0c\u5e76\u9996\u6b21\u805a\u7126\u6570\u636e\u4fc3\u8fdb\u589e\u957f\u8bae\u9898\u8fdb\u884c\u4e86\u6df1\u5165\u8ba8\u8bba\uff0c\u4e30\u5bcc\u4e86APEC\u6570\u636e\u5408\u4f5c\u7684\u5185\u6db5\u3002\u5728\u8d22\u91d1\u9886\u57df\uff0c\u5404\u65b9\u56f4\u7ed5\u5168\u7403\u548c\u533a\u57df\u5b8f\u89c2\u7ecf\u6d4e\u91d1\u878d\u5f62\u52bf\u4ee5\u53ca\u76f8\u5173\u91cd\u70b9\u8bae\u9898\u8fdb\u884c\u6df1\u5165\u4ea4\u6d41\uff0c\u8fdb\u4e00\u6b65\u52a0\u5f3a\u4e86\u5b8f\u89c2\u7ecf\u6d4e\u653f\u7b56\u534f\u8c03\uff0c\u5728\u652f\u6301\u6c11\u751f\u53d1\u5c55\u7684\u8d22\u653f\u653f\u7b56\u3001\u6570\u5b57\u57fa\u7840\u8bbe\u65bd\u878d\u8d44\u3001\u666e\u60e0\u91d1\u878d\u7b49\u65b9\u9762\u5f00\u5c55\u4e86\u66f4\u6709\u529b\u7684\u591a\u8fb9\u5408\u4f5c\u3002\u5728\u5176\u4ed6\u52a1\u5b9e\u5408\u4f5c\u9886\u57df\uff0c\u4e2d\u65b9\u4e5f\u53d6\u5f97\u4e86\u4e00\u7cfb\u5217\u79ef\u6781\u6210\u679c\u3002\u901a\u8fc7\u4e00\u7cfb\u5217\u4e13\u4e1a\u90e8\u957f\u4f1a\u8bae\uff0c\u6211\u4eec\u63d0\u5347\u4e86\u5973\u6027\u6570\u5b57\u5316\u7d20\u517b\u548c\u521b\u4e1a\u5c31\u4e1a\uff0c\u63a2\u8ba8\u4e86\u4e9a\u592a\u533a\u57df\u65c5\u6e38\u4fbf\u5229\u5316\u4e3e\u63aa\uff0c\u660e\u786e\u4e86\u68ee\u6797\u6cbb\u7406\u3001\u6797\u4ea7\u54c1\u8d38\u6613\u5408\u4f5c\u8def\u5f84\uff0c\u5236\u5b9a\u4e86\u589e\u5f3a\u7cae\u98df\u4f53\u7cfb\u97e7\u6027\u7684\u6307\u5bfc\u539f\u5219\uff0c\u589e\u5f3a\u4e86\u5730\u533a\u4e2d\u5c0f\u4f01\u4e1a\u521b\u65b0\u548c\u97e7\u6027\u53d1\u5c55\u80fd\u529b\uff0c\u6df1\u5316\u4e86\u201c\u4e9a\u592a\u80fd\u6e90\u5171\u540c\u4f53\u201d\u7406\u5ff5\uff0c\u63a8\u52a8\u4e86\u4e9a\u592a\u5730\u533a\u4eba\u529b\u8d44\u6e90\u73b0\u4ee3\u5316\uff0c\u5f3a\u5316\u4e86\u667a\u6167\u4ea4\u901a\u548c\u4e92\u8054\u4e92\u901a\u5408\u4f5c\u3002\u8fd9\u4e9b\u6210\u679c\u4e3a\u5efa\u8bbe\u4e9a\u592a\u5171\u540c\u4f53\u63d0\u4f9b\u4e86\u6709\u529b\u652f\u6491\u3002\u6b64\u5916\uff0c\u4e2d\u65b9\u8fd8\u4e3b\u529e\u4e86APEC\u9752\u5e74\u521b\u4e1a\u8005\u5927\u4f1a\u3001\u4e9a\u592a\u6c11\u95f4\u793e\u4f1a\u4f1a\u8bae\u3001\u4e9a\u592a\u9ad8\u7aef\u5a92\u4f53\u8bba\u575b\u7b49\u72ec\u5177\u7279\u8272\u7684\u6d3b\u52a8\u3002\u8fd9\u4e9b\u4f1a\u8bae\u548c\u6d3b\u52a8\u6709\u529b\u4fc3\u8fdb\u4e86\u4e9a\u592a\u4eba\u5458\u5f80\u6765\u548c\u6c11\u5fc3\u76f8\u901a\uff0c\u589e\u5f3a\u4e86\u201c\u4e2d\u56fd\u5e74\u201d\u5408\u4f5c\u826f\u597d\u52bf\u5934\u3002","multimedia":"","commentid":"live:finance-152-5218973:0","compere_id":0,"creator":"yujian@staff.sina.com.cn","mender":"yujian@staff.sina.com.cn","create_time":"2026-11-17 10:31:34","update_time":"2026-11-17 10:31:34","is_need_check":"0","check_time":"1970-01-01 08:00:01","check_status":"1","check_user":"","is_delete":0,"top_value":0,"is_focus":0,"source_content_id":"0","anchor_image_url":"","anchor":"","ext":"{\"stocks\":[{\"market\":\"cn\",\"symbol\":\"sh601009\",\"key\":\"\u5357\u4eac\"},{\"market\":\"hk\",\"symbol\":\"01315\",\"key\":\"\u7eff\u8272\u7ecf\u6d4e\"},{\"market\":\"fund\",\"symbol\":\"159949\",\"key\":\"\u521b\u65b0\",\"sym_party_status\":\"1\"},{\"market\":\"cn\",\"symbol\":\"si931071\",\"key\":\"\u4eba\u5de5\u667a\u80fd\",\"hot\":2149},{\"market\":\"fund\",\"symbol\":\"159363\",\"key\":\"\u4eba\u5de5\u667a\u80fd\",\"sym_party_status\":\"1\",\"hot\":0},{\"market\":\"sb\",\"symbol\":\"873506\",\"key\":\"\u667a\u6167\u4ea4\u901a\"}],\"needPushWB\":false,\"needCMSLink\":true,\"needCalender\":false,\"terms\":[]}","old_live_cid":"0","tab":"","is_repeat":"0","tag":[{"id":"102","name":"\u56fd\u9645"}],"like_nums":0,"comment_list":{"list":[],"total":0,"thread_show":0,"