10\u652f\u6491\u7f8e\u5143\u7684\u8d44\u672c\u6d41\u52a8\u3002Sachdeva\u8868\u793a\uff0c\u5916\u56fd\u8d44\u91d1\u6bcf\u5e74\u6d41\u5165\u7f8e\u56fd\u80a1\u5e02\u7684\u89c4\u6a21\u5df2\u8d85\u8fc71\u4e07\u4ebf\u7f8e\u5143\uff0c\u6210\u4e3a\u7f8e\u56fd\u8d64\u5b57\u878d\u8d44\u7684\u91cd\u8981\u652f\u67f1\u3002\u5979\u8865\u5145\u8bf4\uff0c\u8fc7\u53bb\u4e00\u5e74\u7684\u8d44\u91d1\u6d41\u5165\u589e\u91cf\u5927\u90e8\u5206\u6765\u81ea\u4e9a\u6d32\u3002\u201c\u6d41\u5165\u80a1\u5e02\u7684\u8d44\u91d1\u4e0d\u4ec5\u652f\u6491\u4e86\u7f8e\u5143\uff0c\u4e5f\u4e3a\u63a8\u52a8AI\u57fa\u7840\u8bbe\u65bd\u5efa\u8bbe\u548c\u82af\u7247\u70ed\u6f6e\u7684\u4f01\u4e1a\u63d0\u4f9b\u4e86\u878d\u8d44\uff0c\u201dSachdeva\u8868\u793a\u3002\u201c\u8fd9\u7ed9\u5168\u7403\u8d44\u91d1\u6d41\u52a8\u5e26\u6765\u4e86\u67d0\u79cd\u5faa\u73af\u6027\uff0c\u4ee5\u53ca\u6f5c\u5728\u7684\u4e0d\u7a33\u5b9a\u6027\u3002\u201d","multimedia":"","commentid":"live:finance-152-5218699:0","compere_id":0,"creator":"yongsheng6@staff.sina.com.cn","mender":"yongsheng6@staff.sina.com.cn","create_time":"2026-11-17 07:17:56","update_time":"2026-11-17 07:17:56","is_need_check":"0","check_time":"1970-01-01 08:00:01","check_status":"1","check_user":"","is_delete":0,"top_value":0,"is_focus":0,"source_content_id":"0","anchor_image_url":"","anchor":"","ext":"{\"stocks\":[{\"market\":\"us\",\"symbol\":\"db\",\"key\":\"\\u5fb7\\u610f\\u5fd7\\u94f6\\u884c\"},{\"market\":\"cn\",\"symbol\":\"si931071\",\"key\":\"\\u4eba\\u5de5\\u667a\\u80fd\",\"hot\":2149},{\"market\":\"fund\",\"symbol\":\"159363\",\"key\":\"\\u4eba\\u5de5\\u667a\\u80fd\",\"sym_party_status\":\"1\",\"hot\":0},{\"market\":\"cn\",\"symbol\":\"sih30184\",\"key\":\"\\u534a\\u5bfc\\u4f53\",\"hot\":6257},{\"market\":\"fund\",\"symbol\":\"159558\",\"key\":\"\\u534a\\u5bfc\\u4f53\",\"sym_party_status\":\"1\",\"hot\":0},{\"market\":\"fund\",\"symbol\":\"159352\",\"key\":\"\\u6295\\u8d44\",\"sym_party_status\":\"1\"}],\"needPushWB\":false,\"needCMSLink\":true,\"needCa