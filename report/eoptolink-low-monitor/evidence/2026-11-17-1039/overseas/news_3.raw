ebf\u4e07\u5bcc\u8c6a\u7684\u540c\u540d\u8d44\u91d1\u7ba1\u7406\u516c\u53f8\u5728\u622a\u81f39\u670830\u65e5\u7684\u5b63\u5ea6\u5c06\u82f1\u4f1f\u8fbe\u6301\u80a1\u524a\u51cf\u8fd1\u4e94\u5206\u4e4b\u4e00\uff0c\u662f\u4eca\u5e74\u4ee5\u6765\u62ab\u9732\u7684\u6700\u5927\u5e45\u5ea6\u51cf\u6301\uff1b\u6b64\u524d\u8be5\u516c\u53f8\u66fe\u52a0\u7801\u82f1\u4f1f\u8fbe\u3002Michael Platt\u65d7\u4e0b\u7684BlueCrest Capital Management\uff0c\u4ee5\u53ca\u4e3a\u963f\u5e03\u624e\u6bd4\u7edf\u6cbb\u8005Sheikh Mohamed bin Zayed Al Nahyan\u7ba1\u7406\u8d44\u4ea7\u7684\u4e00\u5bb6\u6295\u8d44\u516c\u53f8\uff0c\u4e5f\u5728\u540c\u671f\u51cf\u6301\u82f1\u4f1f\u8fbe\u3002\u51cf\u6301\u82f1\u4f1f\u8fbe\u7684\u5bb6\u65cf\u529e\u516c\u5ba4\u81f3\u5c1112\u5bb6\uff0c\u4f46\u5168\u90fd\u4fdd\u7559\u4e86\u90e8\u5206\u6301\u80a1\uff0c\u622a\u81f3\u7b2c\u4e09\u5b63\u672b\u5408\u8ba1\u6301\u6709\u7684\u82f1\u4f1f\u8fbe\u80a1\u7968\u4ef7\u503c\u8d85\u8fc710\u4ebf\u7f8e\u5143\u3002\u5bf9\u5176\u4e2d\u8bb8\u591a\u673a\u6784\u800c\u8a00\uff0c\u82f1\u4f1f\u8fbe\u4ecd\u662f\u5176\u4e3b\u8981\u7f8e\u80a1\u6301\u4ed3\u4e4b\u4e00\u3002","multimedia":"","commentid":"live:finance-152-5218697:0","compere_id":0,"creator":"yongsheng6@staff.sina.com.cn","mender":"yongsheng6@staff.sina.com.cn","create_time":"2026-11-17 07:14:54","update_time":"2026-11-17 07:14:54","is_need_check":"0","check_time":"1970-01-01 08:00:01","check_status":"1","check_user":"","is_delete":0,"top_value":0,"is_focus":0,"source_content_id":"0","anchor_image_url":"","anchor":"","ext":"{\"stocks\":[{\"market\":\"us\",\"symbol\":\"nvda\",\"key\":\"\\u82f1\\u4f1f\\u8fbe\"},{\"market\":\"fund\",\"symbol\":\"159352\",\"key\":\"\\u6295\\u8d44\",\"sym_party_status\":\"1\"}],\"needPushWB\":false,\"needCMSLink\":true,\"needCalender\":false,\"terms\":[],\"docurl\":\"https:\\\/\\\/finance.sina.com.cn\\\/7x24\\\/2026-11-17\\\/doc-iniyyvsp5552005.shtml\",\"docid\":\"niyyvsp5552005\"}","old_live_cid":"0","tab":"","is_repeat":"0","tag":[{"id":"3","name":"\u516c\u53f8"}],"like_nums":0,"comment_list":{"list":[],"total":0,"thread_show":0,"qreply":0,"qreply_show":0,"show":0},"docurl":"https:\/\/finance.sina.cn\/7x24\/2026-11-17\/detail-iniyyvsp5552005.d.html","rich_text_nick_to_url":[],"rich_text_nick_to_routeUri":[],"compere_info":""},{"id":5218696,"zhibo_id":152,"type":0,"rich_text":"\u3010\u8fd130\u4ebf\u6b27\u5143\u5e76\u8d2d\u751f\u53d8\uff1aCVC\u62df\u9000\u51fa\u5411Advent\u6536\u8d2d\u610f\u5927\u5229\u98df\u54c1\u539f\u6599\u5546IRCA\u3011\u636e\u82f1\u56fd\u91d1\u878d\u65f6\u62a5\u62a5\u9053\uff0c\u79c1\u52df\u80a1\u6743\u5de8\u5934 CVC Capital Partners \u8ba1\u5212\u9000\u51fa\u4e00\u9879\u4ef7\u503c\u8fd130\u4ebf\u6b27\u5143\u7684\u6536\u8d2d\u534f\u8bae\uff0c\u53d6\u6d88\u4ece\u7ade\u4e89\u5bf9\u624b Advent International \u624b\u4e2d\u6536\u8d2d\u610f\u5927\u5229\u98df\u54c1\u539f\u6599\u96c6\u56e2 IRCA \u7684\u4ea4\u6613\u3002 CVC \u5728\u51e0\u5468\u524d\u5df2\u901a\u77e5 Advent \u6253\u7b97\u653e\u5f03\u8be5\u6536\u8d2d\u534f\u8bae\u3002CVC \u5728\u58f0\u660e\u4e2d\u8868\u793a\uff0c\u516c\u53f8\u5bf9\u5c3d\u804c\u8c03\u67e5\u671f\u95f4\u83b7\u5f97\u7684\u8d22\u52a1\u4fe1\u606f\u8fdb\u884c\u4e86\u6df1\u5165\u7684\u6cd5\u52a1\u5ba1\u8ba1\uff08forensic analysis\uff09\uff0c\u7ed3\u679c\u663e\u793a\u8be5\u4ea4\u6613\u5df2\u4e0d\u518d\u5177\u5907\u53ef\u884c\u6027\u3002 \u79c1\u52df\u80a1\u6743\u673a\u6784\u5728\u6b63\u5f0f\u7b7e\u7f72\u6536\u8d2d\u534f\u8bae\u540e\u53cd\u6094\u7684\u60c5\u51b5\u6781\u4e3a\u7f55\u89c1\uff0c\u6b64\u4e3e\u53ef\u80fd\u4f1a\u5728\u8fd9\u4e24\u5bb6\u91d1\u878d\u5de8\u5934\u4e4b\u95f4\u5f15\u53d1\u4e00\u573a\u6cd5\u5f8b\u6218\u3002\u534f\u8bae\u7b7e\u7f72\u65f6\u95f4\u3002 \u53cc\u65b9\u4e8e 2026\u5e746\u670829\u65e5 \u6b63\u5f0f\u5ba3\u5e03\u8fbe\u6210\u8be5\u6536\u8d2d\u534f\u8bae\uff0c\u539f\u8ba1\u5212\u5728 2026\u5e74\u7b2c\u56db\u5b63\u5ea6 \u5b8c\u6210\u4ea4\u5272\u3002 IRCA \u603b\u90e8\u4f4d\u4e8e\u610f\u5927\u5229\uff0c\u662f\u4e00\u5bb6\u9762\u5411\u70d8\u7119\u3001\u