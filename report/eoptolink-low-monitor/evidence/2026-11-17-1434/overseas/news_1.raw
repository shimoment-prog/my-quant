i7641538.d.html","rich_text_nick_to_url":[],"rich_text_nick_to_routeUri":[],"compere_info":""},{"id":5219227,"zhibo_id":152,"type":0,"rich_text":"\u3010\u7b2c\u4e8c\u6b21\u4e2d\u52a0\u7ecf\u6d4e\u8d22\u91d1\u6218\u7565\u5bf9\u8bdd\u8054\u5408\u6210\u679c\u6587\u4ef6\u53d1\u5e03\u3011\u53cc\u65b9\u6b22\u8fce\u901a\u8fc7\u5e76\u7b7e\u7f72\u4e2d\u52a0\u91d1\u878d\u5de5\u4f5c\u7ec4\u5de5\u4f5c\u89c4\u8303\uff0c\u5e76\u8ba1\u5212\u4e3e\u884c\u7b2c\u4e8c\u6b21\u4f1a\u8bae\u3002\u53cc\u65b9\u540c\u610f\u91d1\u878d\u5de5\u4f5c\u7ec4\u5c06\u63a8\u52a8\u53cc\u8fb9\u91d1\u878d\u9886\u57df\u52a1\u5b9e\u5408\u4f5c\uff0c\u5e76\u5411\u4e2d\u52a0\u7ecf\u6d4e\u8d22\u91d1\u6218\u7565\u5bf9\u8bdd\u62a5\u544a\u8fdb\u5c55\uff1b\u53cc\u65b9\u6b22\u8fce\u5c31\u91d1\u878d\u5de5\u4f5c\u7ec4\u6280\u672f\u4ea4\u6d41\u4e0e\u5408\u4f5c\u8bae\u9898\u8fbe\u6210\u4e00\u81f4\uff0c\u5305\u62ec\uff1a\u6d4b\u8bd5\u5e76\u8ba8\u8bba\u4f7f\u7528\u8fd1\u671f\u7eed\u7b7e\u7684\u53cc\u8fb9\u672c\u5e01\u4e92\u6362\u534f\u8bae\uff1b\u63a2\u7d22\u6269\u5927\u53cc\u8fb9\u8d38\u6613\u548c\u6295\u8d44\u4e2d\u7684\u672c\u5e01\u4f7f\u7528\uff1b\u9f13\u52b1\u53cc\u5411\u6295\u8d44\uff0c\u5305\u62ec\u901a\u8fc7\u4e2d\u56fd\u7684\u5408\u683c\u5883\u5916\u6295\u8d44\u8005\u548c\u5408\u683c\u5883\u5185\u673a\u6784\u6295\u8d44\u8005\u6846\u67b6\uff1b\u4ee5\u53ca\u5728\u591a\u8fb9\u5e73\u53f0\u4fc3\u8fdb\u7eff\u8272\u548c\u53ef\u6301\u7eed\u91d1\u878d\u7684\u8ba8\u8bba\u7b49\u3002\u53cc\u65b9\u5728\u4ee5\u4e0b\u65b9\u9762\u5f00\u5c55\u4e86\u5bcc\u6709\u6210\u6548\u7684\u6280\u672f\u4ea4\u6d41\uff1a\u5305\u62ec\u718a\u732b\u503a\u53d1\u884c\u3001\u63d0\u9ad8\u8de8\u5883\u652f\u4ed8\u7cfb\u7edf\u6548\u7387\u4ee5\u53ca\u53cd\u6d17\u94b1\u548c\u53cd\u6050\u6016\u878d\u8d44\u7b49\uff1b\u53cc\u65b9\u6b22\u8fce\u4e2d\u56fd\u4eba\u6c11\u94f6\u884c\u548c\u52a0\u62ff\u5927\u592e\u884c\u843d\u5b9e\u53cc\u8fb9\u672c\u5e01\u4e92\u6362\u534f\u8bae\uff0c\u5305\u62ec\u8ba1\u5212\u57282026\u5e74\u5e95\u524d\u8fdb\u884c\u6f14\u7ec3\uff0c\u57282027\u5e74\u6d4b\u8bd5\u52a8\u7528\uff0c\u505a\u597d\u4e1a\u52a1\u51c6\u5907\uff0c\u7ef4\u62a4\u5168\u7403\u91d1\u878d\u7a33\u5b9a\uff1b\u53cc\u65b9\u6b22\u8fce\u4e2d\u52a0\u91d1\u878d\u76d1\u7ba1\u5408\u4f5c\u4f1a\u8bae\u5728\u672c\u6b21\u5bf9\u8bdd\u671f\u95f4\u4e3e\u884c\uff0c\u5c31\u91d1\u878d\u90e8\u95e8\u5408\u4f5c\u4e0e\u5546\u4e1a\u673a\u4f1a\u8fdb\u884c\u8ba8\u8bba\u3002\u8be5\u4f1a\u8bae\u4e8e2026\u5e7411\u67088\u65e5\u5728\u6e29\u54e5\u534e\u4e3e\u884c\uff0c\u53cc\u65b9\u9f13\u52b1\u7b26\u5408\u6761\u4ef6\u7684\u91d1\u878d\u673a\u6784\u5728\u5f7c\u6b64\u5e02\u573a\u6295\u8d44\u5c55\u4e1a\u3002\u53cc\u65b9\u540c\u610f\uff0c\u91d1\u878d\u76d1\u7ba1\u90e8\u95e8\u5c06\u63a8\u8fdb\u53cc\u8fb9\u52a1\u5b9e\u91d1\u878d\u5408\u4f5c\uff0c\u5e76\u5411\u4e2d\u52a0\u7ecf\u6d4e\u8d22\u91d1\u6218\u7565\u5bf9\u8bdd\u62a5\u544a\u8fdb\u5c55\uff1b.\u53cc\u65b9\u8ba4\u4e3a\u6709\u5fc5\u8981\u52a0\u5f3a\u91d1\u878d\u7a33\u5b9a\u3001\u91d1\u878d\u79d1\u6280\u7b49\u9886\u57df\u7684\u6c9f\u901a\u5408\u4f5c\uff0c\u4ee5\u5171\u540c\u5e94\u5bf9\u5168\u7403\u7ecf\u6d4e\u91d1\u878d\u6311\u6218\u3002\u53cc\u65b9\u652f\u6301\u52a0\u5f3a\u4e24\u56fd\u8bc1\u5238\u671f\u8d27\u76d1\u7ba1\u90e8\u95e8\u5728\u56fd\u9645\u8bc1\u76d1\u4f1a\u7ec4\u7ec7\uff08IOSCO\uff09\u7b49\u591a\u8fb9\u6846\u67b6\u4e0b\u4ea4\u6d41\u3002","multimedia":"","commentid":"live:finance-152-5219227:0","compere_id":0,"creator":"yujian@staff.sina.com.cn","mender":"yujian@staff.sina.com.cn","create_time":"2026-11-17 13:54:52","update_time":"2026-11-17 13:54:52","is_need_check":"1","check_time":"2026-11-17 13:54:59","check_status":"1","check_user":"yongsheng6@staff.sina.com.cn","is_delete":0,"top_value":0,"is_focus":0,"source_content_id":"0","anchor_image_url":"","anchor":"","ext":"{\"stocks\":[{\"market\":\"fund\",\"symbol\":\"159352\",\"key\":\"\u6295\u8d44\",\"sym_party_status\":\"1\"},{\"market\":\"cn\",\"symbol\":\"si930986\",\"key\":\"\u91d1\u878d\u79d1\u6280\",\"hot\":700}],\"needPushWB\":false,\"needCMSLink\":