yznqi2228555.d.html","rich_text_nick_to_url":[],"rich_text_nick_to_routeUri":[],"compere_info":""},{"id":5219276,"zhibo_id":152,"type":0,"rich_text":"\u3010\u9752\u6d77\u7701\u6d77\u4e1c\u5e02\u653f\u534f\u539f\u515a\u7ec4\u6210\u5458\u3001\u526f\u4e3b\u5e2d\u9a6c\u7ef4\u5fe0\u88ab\u5f00\u9664\u515a\u7c4d\u548c\u516c\u804c\u3011\u9752\u6d77\u7701\u7eaa\u59d4\u76d1\u59d417\u65e5\u901a\u62a5\uff0c\u7ecf\u4e2d\u5171\u9752\u6d77\u7701\u59d4\u6279\u51c6\uff0c\u9752\u6d77\u7701\u7eaa\u59d4\u76d1\u59d4\u5bf9\u9752\u6d77\u7701\u6d77\u4e1c\u5e02\u653f\u534f\u539f\u515a\u7ec4\u6210\u5458\u3001\u526f\u4e3b\u5e2d\u9a6c\u7ef4\u5fe0\u4e25\u91cd\u8fdd\u7eaa\u8fdd\u6cd5\u95ee\u9898\u8fdb\u884c\u4e86\u7acb\u6848\u5ba1\u67e5\u8c03\u67e5\u3002 \u7ecf\u67e5\uff0c\u9a6c\u7ef4\u5fe0\u4e27\u5931\u7406\u60f3\u4fe1\u5ff5\uff0c\u80cc\u5f03\u521d\u5fc3\u4f7f\u547d\uff0c\u5bf9\u6297\u7ec4\u7ec7\u5ba1\u67e5\uff1b\u7f54\u987e\u4e2d\u592e\u516b\u9879\u89c4\u5b9a\u7cbe\u795e\uff0c\u8fdd\u89c4\u6536\u53d7\u793c\u54c1\u3001\u793c\u91d1\u3001\u6d88\u8d39\u5361\uff0c\u63a5\u53d7\u53ef\u80fd\u5f71\u54cd\u516c\u6b63\u6267\u884c\u516c\u52a1\u7684\u5bb4\u8bf7\uff1b\u5ec9\u6d01\u5e95\u7ebf\u5931\u5b88\uff0c\u7531\u4ed6\u4eba\u652f\u4ed8\u5e94\u7531\u672c\u4eba\u652f\u4ed8\u7684\u8d39\u7528\uff1b\u4e0d\u6b63\u786e\u5c65\u884c\u804c\u8d23\uff0c\u8fdd\u89c4\u4e3a\u4f01\u4e1a\u63d0\u4f9b\u62c5\u4fdd\uff0c\u8fdd\u89c4\u51fa\u501f\u3001\u4f7f\u7528\u4e13\u9879\u8d44\u91d1\uff1b\u79c1\u6b32\u81a8\u80c0\uff0c\u5c06\u516c\u6743\u529b\u5f02\u5316\u4e3a\u8c0b\u53d6\u79c1\u5229\u7684\u5de5\u5177\uff0c\u5927\u641e\u6743\u94b1\u4ea4\u6613\uff0c\u5229\u7528\u804c\u52a1\u4fbf\u5229\u4e3a\u4ed6\u4eba\u5728\u5de5\u7a0b\u9879\u76ee\u627f\u63fd\u7b49\u65b9\u9762\u8c0b\u5229\uff0c\u5e76\u975e\u6cd5\u6536\u53d7\u5de8\u989d\u8d22\u7269\u3002 \u9a6c\u7ef4\u5fe0\u4e25\u91cd\u8fdd\u53cd\u515a\u7684\u653f\u6cbb\u7eaa\u5f8b\u3001\u5ec9\u6d01\u7eaa\u5f8b\u548c\u5de5\u4f5c\u7eaa\u5f8b\uff0c\u6784\u6210\u4e25\u91cd\u804c\u52a1\u8fdd\u6cd5\u5e76\u6d89\u5acc\u53d7\u8d3f\u72af\u7f6a\uff0c\u4e14\u5728\u515a\u7684\u5341\u516b\u5927\u540e\u4e0d\u6536\u655b\u3001\u4e0d\u6536\u624b\uff0c\u6027\u8d28\u4e25\u91cd\uff0c\u5f71\u54cd\u6076\u52a3\uff0c\u5e94\u4e88\u4e25\u8083\u5904\u7406\u3002\u4f9d\u636e\u300a\u4e2d\u56fd\u5171\u4ea7\u515a\u7eaa\u5f8b\u5904\u5206\u6761\u4f8b\u300b\u300a\u4e2d\u534e\u4eba\u6c11\u5171\u548c\u56fd\u76d1\u5bdf\u6cd5\u300b\u300a\u4e2d\u534e\u4eba\u6c11\u5171\u548c\u56fd\u516c\u804c\u4eba\u5458\u653f\u52a1\u5904\u5206\u6cd5\u300b\u7b49\u6709\u5173\u89c4\u5b9a\uff0c\u7ecf\u4e2d\u5171\u9752\u6d77\u7701\u7eaa\u59d4\u5e38\u59d4\u4f1a\u4f1a\u8bae\u7814\u7a76\u5e76\u62a5\u4e2d\u5171\u9752\u6d77\u7701\u59d4\u6279\u51c6\uff0c\u51b3\u5b9a\u7ed9\u4e88\u9a6c\u7ef4\u5fe0\u5f00\u9664\u515a\u7c4d\u5904\u5206\uff1b\u7531\u9752\u6d77\u7701\u76d1\u59d4\u7ed9\u4e88\u5176\u5f00\u9664\u516c\u804c\u5904\u5206\uff1b\u6536\u7f34\u5176\u8fdd\u7eaa\u8fdd\u6cd5\u6240\u5f97\uff1b\u5c06\u5176\u6d89\u5acc\u72af\u7f6a\u95ee\u9898\u79fb\u9001\u68c0\u5bdf\u673a\u5173\u4f9d\u6cd5\u5ba1\u67e5\u8d77\u8bc9\uff0c\u6240\u6d89\u8d22\u7269\u4e00\u5e76\u79fb\u9001\u3002\uff08\u65b0\u534e\u793e\uff09","multimedia":"","commentid":"live:finance-152-5219276:0","compere_id":0,"creator":"mingliang10@staff.sina.com.cn","mender":"mingliang10@staff.sina.com.cn","create_time":"2026-11-17 14:28:20","update_time":"2026-11-17 14:28:20","is_need_check":"1","check_time":"2026-11-17 14:28:40","check_status":"1","check_user":"mingliang10@staff.sina.com.cn","is_delete":0,"top_value":0,"is_focus":0,"source_content_id":"0","anchor_image_url":"","anchor":"","ext":"{\"stocks\":[],\"needPushWB\":false,\"needCMSLink\":true,\"needCalender\":false,\"terms\":[],\"docurl\":\"https:\\\/\\\/finance.sina.com.cn\\\/7x24\\\/2026-11-17\\\/doc-iniyznqi2228469.shtml\",\"docid\":\"niyznqi2228469\"}","old_live_cid":"0","tab":"","is_repeat":"0","tag":[{"id":"110","name":"\u4e24\u4f1a"}],"like_nums":0,"comment_list":{"list":[],"total":0,"thread_show":0,"qreply":