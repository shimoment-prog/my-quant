<style id="wp-custom-css">
.report-download-consent {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 16px;
    cursor: pointer;
    color: #ffffff;
    line-height: 1.5;
    text-align: left;
}

.report-download-consent span{
    display:block;
    text-align:left;
}

.report-download-consent input[type="checkbox"] {
    width: 18px;
    height: 18px;
    margin-top: 4px;
    accent-color: #9ca3af;
}

.button-download.is-disabled {
    pointer-events: none;
    opacity: 0.5;
    cursor: not-allowed;
}
</style>
		<style id="site-designer-logo-constraints">
			.wp-block-site-logo.is-default-size img {
				width: auto;
				height: auto;
				max-width: 180px;
				max-height: 80px;
			}
			.wp-block-site-logo img {
				height: auto;
			}
		</style>
		
	<!--[if lt IE 9]>
		<script src="https://muddywatersresearch.com/wp-content/themes/mwr/js/IE9.min.js"></script>
	<![endif]-->

	
</head>

<body class="wp-singular page-template page-template-tpl-research page-template-tpl-research-php page page-id-66 wp-theme-mwr singular">
	<div id="page-container" class="layout-container"> 
		<header id="page-header" class="layout-header">
