524d\u6765\u5927\u9646\u53c2\u89c2\u3001\u65c5\u6e38\u7684\u53f0\u80de\u5bf9\u6b64\u4e5f\u611f\u540c\u8eab\u53d7\u3002 \u5173\u4e8e\u6295\u8d44\u73af\u5883\uff0c\u5927\u9646\u662f\u53f0\u6e7e\u4f01\u4e1a\u7406\u60f3\u3001\u5b89\u5168\u3001\u6709\u4e3a\u7684\u6295\u8d44\u76ee\u7684\u5730\uff0c\u66f4\u662f\u53f0\u5546\u53f0\u80de\u5927\u4f5c\u4e3a\u5927\u53d1\u5c55\u7684\u6700\u4f73\u9009\u62e9\u3002\u9762\u5bf9\u53d8\u4e71\u4ea4\u7ec7\u7684\u4e16\u754c\u5c40\u52bf\uff0c\u5927\u9646\u7ecf\u6d4e\u9876\u538b\u524d\u884c\u3001\u7a33\u4e2d\u6c42\u8fdb\uff0c\u5411\u65b0\u5411\u4f18\u52bf\u5934\u4e0d\u65ad\u5de9\u56fa\u3002\u4eca\u5e741\u81f310\u6708\uff0c\u5927\u9646\u89c4\u6a21\u4ee5\u4e0a\u5de5\u4e1a\u589e\u52a0\u503c\u540c\u6bd4\u589e\u957f5.3%\uff0c\u88c5\u5907\u5236\u9020\u4e1a\u548c\u9ad8\u6280\u672f\u5236\u9020\u4e1a\u652f\u6491\u660e\u663e\uff1b\u793e\u4f1a\u6d88\u8d39\u5546\u54c1\u548c\u670d\u52a1\u96f6\u552e\u603b\u989d\u540c\u6bd4\u589e\u957f2.5%\uff0c\u670d\u52a1\u96f6\u552e\u8f83\u5feb\u589e\u957f\uff1b\u8d27\u7269\u8d38\u6613\u8fdb\u51fa\u53e3\u603b\u503c44.81\u4e07\u4ebf\u5143\uff0c\u540c\u6bd4\u589e\u957f20%\uff0c\u4fdd\u6301\u5f3a\u52b2\u6001\u52bf\u300210\u6708\u672b\uff0c\u5927\u9646\u793e\u4f1a\u878d\u8d44\u603b\u5b58\u91cf\u4e3a469.16\u4e07\u4ebf\u5143\uff0c\u540c\u6bd4\u589e\u957f7.2%\uff1b\u5e7f\u4e49\u8d27\u5e01\u4f59\u989d359.06\u4e07\u4ebf\u5143\uff0c\u540c\u6bd4\u589e\u957f7.1%\u3002\u6211\u4eec\u5c06\u6301\u7eed\u8425\u9020\u5e02\u573a\u5316\u3001\u6cd5\u6cbb\u5316\u3001\u56fd\u9645\u5316\u4e00\u6d41\u8425\u5546\u73af\u5883\uff0c\u4e3a\u5305\u62ec\u53f0\u4f01\u5728\u5185\u5404\u79cd\u7ecf\u8425\u4e3b\u4f53\u6253\u9020\u66f4\u52a0\u7a33\u5b9a\u3001\u900f\u660e\u3001\u53ef\u9884\u671f\u7684\u6295\u8d44\u73af\u5883\u3002","multimedia":"","commentid":"live:finance-152-5221605:0","compere_id":0,"creator":"yujian@staff.sina.com.cn","mender":"yujian@staff.sina.com.cn","create_time":"2026-11-18 10:37:54","update_time":"2026-11-18 10:37:54","is_need_chec