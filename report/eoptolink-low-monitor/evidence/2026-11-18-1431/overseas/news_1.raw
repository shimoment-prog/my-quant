u5ea6\u8868\u73b0\uff0c\u6838\u5fc3\u96f6\u552e\u9500\u552e\u540c\u6837\u8d85\u9884\u671f\u8d70\u5f3a\u3002\u5177\u4f53\u6765\u770b\uff0c\u8ba1\u5165GDP\u7684\u6838\u5fc3\u201c\u96f6\u552e\u9500\u552e\u5bf9\u7167\u5c0f\u7ec4\u201d\u73af\u6bd40.6%\uff0c\u5927\u5e45\u9ad8\u4e8e\u9884\u671f\u76840.4%\u4e0e\u524d\u503c0.1%\uff0c\u6838\u5fc3\u96f6\u552e\u9500\u552e\u6708\u7387\u540c\u6837\u4e3a0.6%\u3001\u9ad8\u4e8e\u9884\u671f\u76840.4%\uff0c\u96f6\u552e\u9500\u552e\u603b\u989d7482.2\u4ebf\u7f8e\u5143\u3001\u6838\u5fc3\u90e8\u52066112.26\u4ebf\u7f8e\u5143\u3002\u7269\u4ef7\u7aef\u540c\u6b65\u504f\u70ed\uff1a10\u6708\u8fdb\u53e3\u7269\u4ef7\u6307\u6570\u6708\u73871.1%\uff0c\u9ad8\u4e8e\u9884\u671f\u76840.7%\u3001\u4e0e\u524d\u503c\u6301\u5e73\uff0c\u51fa\u53e3\u7269\u4ef7\u6307\u6570\u6708\u7387\u540c\u6837\u4e3a1.1%\u3001\u8fdc\u9ad8\u4e8e\u9884\u671f\u76840.5%\u2014\u2014\u5173\u7a0e\u4e0e\u80fd\u6e90\u6210\u672c\u5411\u8fdb\u53e3\u7aef\u4f20\u5bfc\u7684\u75d5\u8ff9\u5df2\u7ecf\u843d\u5728\u6708\u5ea6\u6570\u636e\u91cc\u3002\u7f8e\u8054\u50a8\u5723\u8def\u6613\u65af\u8054\u50a8\u884c\u957f\u91ca\u653e\u9e70\u6d3e\u4fe1\u53f7\uff0c\u6697\u793a\u672a\u6765\u6570\u6708\u5185\u9700\u8981\u591a\u6b21\u52a0\u606f\uff0c\u4ee5\u5728\u5408\u7406\u65f6\u95f4\u5185\u5b9e\u73b0\u4ef7\u683c\u7a33\u5b9a\u76ee\u6807\u3002\u5730\u7f18\u653f\u6cbb\u65b9\u9762\uff0c\u7f8e\u519b\u518d\u88ad\u4f0a\u6717\u683c\u4ec0\u59c6\u5c9b\u3002\u672c\u8f6e\u9ec4\u91d1\u4e0b\u8dcc\u7684\u6838\u5fc3\u9a71\u52a8\u4f9d\u7136\u662f\u7f8e\u56fd\u901a\u80c0\u7c98\u6027\u8d85\u9884\u671f\uff0c\u53e0\u52a0\u7f8e\u8054\u50a8\u5b98\u5458\u96c6\u4f53\u91ca\u653e\u9e70\u6d3e\u4fe1\u53f7\uff0c\u5e02\u573a\u91cd\u65b0\u5b9a\u4ef7\u52a0\u606f\u8def\u5f84\uff0c\u63a8\u5347\u5b9e\u9645\u5229\u7387\u4e0e\u7f8e\u5143\u6307\u6570\uff0c\u5f62\u6210\u5bf9\u8d35\u91d1\u5c5e\u7684\u53cc\u91cd\u538b\u5236\u3002\u77ed\u671f\u8d35\u91d1\u5c5e\u4ecd\u5904\u4e8e\u627f\u538b\u683c\u5c40\uff0c\u8d8b\u52bf\u6027\u53cd\u5f39\u6761\u4