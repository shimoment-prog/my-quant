<style id="wp-custom-css">
.report-download-consent {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 16px;
    cursor: pointer;
    color: #ffffff;
    line-height: 1.5;
    text-align: left;
}

.report-download-consent span{
    display:block;
    text-align:left;
}

.report-download-consent input[type="checkbox"] {
    width: 18px;
    height: 18px;
    margin-top: 4px;
    accent-color: #9ca3af;
}

.button-download.is-disabled {
    pointer-events: none;
    opacity: 0.5;
    cursor: not-allowed;
}
</style>
		<style id="site-designer-logo-constraints">
			.wp-block-site-logo.is-default-size img {
				width: auto;
				height: auto;
				max-width: 180px;
				max-height: 80px;
			}
			.wp-block-site-logo img {
				height: auto;
			}
		</style>
		
	<!--[if lt IE 9]>
		<script src="https://muddywatersresearch.com/wp-content/themes/mwr/js/IE9.min.js"></script>
	<![endif]-->

	
</head>

<body class="home wp-singular page-template page-template-tpl-fullwidth-sections page-template-tpl-fullwidth-sections-php page page-id-2 wp-theme-mwr singular">
	<div id="page-container" class="layout-container"> 
		<header id="page-header" class="layout-header">
			<div class="container">
				<div class="site-brand">
					<a class="site-brand__link" href="https://muddywatersresearch.com/" title="Muddy Waters Research - Due diligence-based investment research" rel="home">
													<img src="https://muddywatersresearch.com/wp-content/uploads/2017/09/mwr-logo-130x110.jpg" alt="Muddy Waters Research - Due diligence-based investment research" class="site-brand__image">
											</a>
				</div>

				<nav id="primary-nav" class="nav-primary">                
					<div class="nav-primary__main-menu-1">
						<ul class="menu menu--main-1"><li class="menu__item  menu__item--active  menu__item--2"><a href="https://muddywatersresearch.com/" class="menu__link">Home</a></li>
<li class="menu__item  menu__item--5"><a href="https://muddywatersresearch.com/about/" class="menu__link">About</a></li>
<li class="menu__item  menu__item--66"><a href="https://muddywatersresearch.com/research/" class="menu__link">Research</a></li>
