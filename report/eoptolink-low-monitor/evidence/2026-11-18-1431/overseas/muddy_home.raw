	<section class="content-section content-section--padding" id="in-the-news">
		
		<div class="content-section__container container">

			
									<div class="content-section__item content-section__item--content-items columns columns-8 content-items--1 content-section__item--has-title">
															<h3 class="content-section__item-title">
									<a class="content-section__item-title-inner" href="/category/articles">Latest News</a>  
								</h3>
														<div class="content-items">
								
	<article id="post-2403" class="content-item post-2403 post type-post status-publish format-standard has-post-thumbnail hentry category-ehth-news">
		<div class="content-item__wrapper">
							<a href="https://muddywatersresearch.com/2020/04/block-cnbc-squawk-box-ehealth/" title="Block on CNBC’s Squawk Box Discussing Latest Short, eHealth Inc." class="content-item__image-wrapper">
					<img width="564" height="318" src="https://muddywatersresearch.com/wp-content/uploads/2020/04/Block_CNBCSquawkBox_04082020-1.jpg" class="content-item__image wp-post-image" alt="" decoding="async" loading="lazy" srcset="https://muddywatersresearch.com/wp-content/uploads/2020/04/Block_CNBCSquawkBox_04082020-1.jpg 564w, https://muddywatersresearch.com/wp-content/uploads/2020/04/Block_CNBCSquawkBox_04082020-1-300x169.jpg 300w, https://muddywatersresearch.com/wp-content/uploads/2020/04/Block_CNBCSquawkBox_04082020-1-400x226.jpg 400w" sizes="auto, (max-width: 564px) 100vw, 564px" />				</a>
						<div class="content-item__text-wrapper">
									<div class="content-item__taxonomy">
						<a href="https://muddywatersresearch.com/category/articles/ehth-news/" rel="tag">eHealth Inc.</a>					</div>
				
				<header class="content-item__header">
					<h3 class="content-item__title"><a href="https://muddywatersresearch.com/2020/04/block-cnbc-squawk-box-ehealth/" title="Block on CNBC’s Squawk Box Discussing Latest Short, eHealth Inc." class="content-item__title-link">Block on CNBC’s Squawk Box Discussing Latest Short, eHealth Inc.</a></h3>
				</header>

									<div class="content-item__dateline">
