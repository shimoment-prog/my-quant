cb({"bizCode":"","bizMsg":"","code":0,"extra":{},"hitsTotal":8512,"msg":"OK","result":{"cmsArticleWebOld":[{"date":"2026-06-09 17:00:50","image":"","code":"202606093765174790","title":"美思德：子公司发生着火<em>事故 事故</em>区域装置已停产","content":"<em>事故</em>原因及损失尚在调查中。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202606093765174790.html"},{"date":"2026-09-10 07:05:42","image":"","code":"202609103869729141","title":"《档案安全<em>事故</em>应急预案》出台，首次量化档案安全<em>事故</em>等级","content":"日前，国家档案局首次制定国家层面部门预案《档案安全<em>事故</em>应急预案》，对档案安全<em>事故</em>处置全过程进行规范，对于提高档案安全体系效能，有效预防、及时控制和妥善处理各类档案安全<em>事故</em>，最大限度地减少档案安全<em>事故</em>造成的损失，确保档案安全起着重要的作用。","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202609103869729141.html"},{"date":"2026-06-09 17:16:17","image":"","code":"202606093765187447","title":"美思德：子公司发生着火<em>事故 事故</em>区域生产装置三单元停产","content":"截至本公告披露日，子公司<em>事故</em>区域生产装置三单元已按处理决定停产，生产装置其他单元均正常运行。经初步预计，本次<em>事故</em>不会对公司的生产经营构成重大不利影响。","mediaName":"第一财经","url":"http://finance.eastmoney.com/a/202606093765187447.html"},{"date":"2026-05-23 18:57:21","image":"","code":"202605233747364882","title":"针对山西通洲集团留神峪煤<em>矿</em>瓦斯爆炸<em>事故 </em>国务院<em>事故</em>调查组将较真碰硬开展<em>事故</em>调查","content":"针对山西通洲集团留神峪煤矿瓦斯爆炸<em>事故</em>，国务院<em>事故</em>调查组将较真碰硬开展<em>事故</em>调查，查清查透<em>事故</em>原因，查清查透属地管理、行业监管和企业责任，依法依规严厉惩处。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202605233747364882.html"},{"date":"2026-10-21 17:08:00","image":"","code":"202610213902712217","title":"问界发布<em>事故</em>说明","content":"碰撞发生后，车辆紧急呼叫（eCALL）系统即时触发并接通，同时问界道路救援中心拨打122上报<em>事故</em>信息，协助开展救援。对于此次意外<em>事故</em>，我们深表痛心。","mediaName":"券商中国","url":"http://finance.eastmoney.com/a/202610213902712217.html"},{"date":"2026-10-21 18:20:14","image":"","code":"202610213902764776","title":"问界回应起火<em>事故</em>","content":"近日有网传视频显示，在陕西省榆林神木市发生一起交通<em>事故</em>，一辆新能源汽车飞驰经过一路口时，撞上路边信号灯，在短短数秒内起火，相关视频在网络发酵。 　　10月21日，问界用户服务发布关于陕西省榆林神木市车辆<em>事故</em>的说明。","mediaName":"湾财ND","url":"http://finance.eastmoney.com/a/202610213902764776.html"},{"date":"2026-10-21 16:07:56","image":"","code":"202610213903014950","title":"问界回应车辆起火<em>事故</em>","content":"10月21日，问界用户服务发布关于陕西省榆林神木市车辆<em>事故</em>的说明：2026年10月17日23点25分左右，一辆问界汽车在榆林神木市发生碰撞后起火。碰撞发生后，车辆紧急呼叫(eCALL)系统即时触发并接通，同时问界道路救援中心拨打122上报<em>事故</em>信息，协助开展救援。","mediaName":"证券时报","url":"http://insurance.eastmoney.com/a/202610213903014950.html"},{"date":"2026-10-30 06:28:19","image":"","code":"202610303915134866","title":"西班牙高铁<em>事故</em>首份报告公布","content":"而如果没有必要的缓解屏障启动，这一系列故障、指令和行动最终必将导致碰撞<em>事故</em>。报告还指出，调查尚处于初期阶段，后续步骤将包括“分析导致<em>事故</em>发生的起因和情况”。","mediaName":"央视新闻","url":"http://finance.eastmoney.com/a/202610303915134866.html"},{"date":"2026-10-30 06:28:57","image":"","code":"202610303915136450","title":"西班牙高铁<em>事故</em>首份报告公布","content":"当地时间10月29日，西班牙铁路、海事和民用航空<em>事故</em>和事件技术调查独立行政机构在其网站上公布了托莱多省高铁<em>事故</em>第一份报告，该报告估计追尾的西班牙国家铁路公司旗下列车和停止的伊尔约公司列车相撞时，时速在160至200公里之间，但具体数据尚待对列车上的车载记录仪进行审查。","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202610303915136450.html"},{"date":"2026-11-04 14:55:30","image":"","code":"202611043922315785","title":"300432，通报火情<em>事故</em>","content":"【导读】富临精工通报子公司火情<em>事故</em>：无人员伤亡，已第一时间启动内部<em>事故</em>溯源 　　中国基金报记者晨曦 　　11月4日中午，富临精工发布公告，对子公司发生火情<em>事故</em>一事作出说明。","mediaName":"中国基金报","url":"http://finance.eastmoney.com/a/202611043922315785.html"},{"date":"2026-08-30 20:47:37","image":"","code":"202608303859488278","title":"塞浦路斯渡轮倾覆<em>事故</em>已有159人获救","content":"当地时间8月30日，塞浦路斯北部杰尔尼市市长辛库尔表示，当天早些时候在该市北部海面倾覆的渡轮上已有159人获救。目前搜救行动仍在进行中。 　　据悉，事发渡轮上共载有259名乘客和8名船员。事发海域位于塞浦路斯北部基利尼亚港以北2公里处，海域和港口均位于塞浦路斯土族控制区，出事渡轮原本的目的港是土耳其塔苏科港","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202608303859488278.html"},{"date":"2026-05-19 13:51:49","image":"","code":"202605193741809356","title":"美国夏威夷一港口发生燃油泄漏<em>事故</em>","content":"美国海岸警卫队18日说，夏威夷州首府檀香山一处港口发生燃油泄漏<em>事故</em>，目前尚不清楚泄漏量和泄漏源头，海岸警卫队与夏威夷州应急部门正在采取措施应对<em>事故</em>。 　　根据美国海岸警卫队的声明，海岸警卫队檀香山分区指挥中心17日晚接到报告，一处港口北侧码头附近发生燃油泄漏<em>事故</em>。","mediaName":"新华社","url":"http://finance.eastmoney.com/a/202605193741809356.html"},{"date":"2026-10-18 01:45:41","image":"","code":"202610183899089421","title":"印度东部踩踏<em>事故</em>致17人死亡","content":"据印度方面17日消息，印度东部西孟加拉邦首府加尔各答一处印度教节日庆祝活动现场当晚发生踩踏<em>事故</em>，造成至少17人死亡、多人受伤。","mediaName":"央视新闻客户端","url":"http://finance.eastmoney.com/a/202610183899089421.html"},{"date":"2026-05-17 00:56:40","image":"","code":"202605173739644565","title":"泰国总理下令彻查火车与巴士相撞<em>事故</em>","content":"泰国总理阿努廷16日晚在曼谷火车与公交车相撞<em>事故</em>现场下令彻查<em>事故</em>原因，全力救助伤者。 　　当天下午，曼谷一处铁路道口发生交通<em>事故</em>，一列由北柳府驶往曼谷挽赐站的货运火车，与一辆公交车相撞。<em>事故</em>波及多辆轿车及摩托车，现场起火并传出爆炸声。","mediaName":"新华社","url":"http://finance.eastmoney.com/a/202605173739644565.html"},{"date":"2026-06-03 15:41:00","image":"","code":"202606033758995924","title":"浙江一车辆<em>事故</em>起火，问界回应","content":"6月3日，“问界用户服务”官方账号发布一则有关浙江省台州市车辆<em>事故</em>的说明，指出该<em>事故</em>并非车辆自身原因导致。 　　据悉，2026年6月3日，一辆问界M9在浙江省台州市泽国镇发生<em>事故</em>，<em>事故</em>未造成人员伤亡。","mediaName":"南方都市报","url":"http://finance.eastmoney.com/a/202606033758995924.html"},{"date":"2026-05-23 13:05:00","image":"","code":"202605233747333562","title":"山西煤<em>矿事故</em>已造成73人死亡","content":"据央视新闻，记者从山西通洲集团留神峪煤矿瓦斯爆炸<em>事故</em>现场了解到，<em>事故</em>已造成73人死亡。目前，<em>事故</em>救援工作仍在紧张进行中。","mediaName":"蓝鲸新闻","url":"http://finance.eastmoney.com/a/202605233747333562.html"},{"date":"2026-05-23 22:56:46","image":"","code":"202605233747403261","title":"留神峪煤<em>矿事故</em>存在次生灾害风险","content":"据新华社，5月23日，山西通洲集团留神峪煤矿瓦斯爆炸<em>事故</em>救援指挥部召开新闻发布会：<em>事故</em>现场有毒有害气体长时间超限，存在发生次生灾害风险。","mediaName":"第一财经","url":"http://finance.eastmoney.com/a/202605233747403261.html"},{"date":"2026-06-05 19:30:36","image":"","code":"202606053762116039","title":"小鹏回应网传山东车辆起火<em>事故</em>","content":"6月5日，@小鹏辟谣发文表示：“网传4日山东平度小鹏汽车起火相关报道，我司第一时间排查分析事发地车辆数据，未发现车辆热失控相关信息。”","mediaName":"每日经济新闻","url":"http://finance.eastmoney.com/a/202606053762116039.html"},{"date":"2026-07-24 10:22:17","image":"","code":"202607243820112649","title":"圭亚那沉船<em>事故</em>遇难人数升至72人","content":"当地时间23日，圭亚那总理菲利普斯表示，日前该国发生的“巴里马”号渡轮沉船<em>事故</em>确认遇难人数增至72人，其中65人的身份得到家属确认，搜寻和打捞行动仍在继续进行。当地时间18日晚，“巴里马”号渡轮在圭亚那海岸附近沉没，该船曾发出求救信号。","mediaName":"每日经济新闻","url":"http://global.eastmoney.com/a/202607243820112649.html"},{"date":"2026-10-18 04:50:07","image":"","code":"202610183899091254","title":"莫桑比克中部交通<em>事故</em>造成13人死亡","content":"据当地电视台报道，<em>事故</em>造成9人当场死亡，20名伤者被送往太特省医院，其中4人不治身亡，部分伤者伤势严重。涉事客车司机已被警方拘留，<em>事故</em>具体原因仍在调查中。 　　近年来，太特省道路交通<em>事故</em>频发。当地电视台17日的报道说，该省今年以来交通<em>事故</em>致死人数已超过40人。","mediaName":"央视新闻","url":"http://finance.eastmoney.com/a/202610183899091254.html"},{"date":"2026-06-03 21:10:42","image":"","code":"202606033759275234","title":"菲律宾在建楼房坍塌<em>事故</em>已致27人死亡","content":"据央视新闻，记者获悉，截至6月3日晚，菲律宾北部安赫莱斯市5月24日发生的在建楼房坍塌<em>事故</em>已导致27人死亡，仍有多人失踪。该在建楼房于5月24日凌晨3时许发生坍塌，一度导致至少30人受困。安赫莱斯市信息办公室说，坍塌建筑为混凝土结构，事发时已建至第九层。","mediaName":"第一财经","url":"http://global.eastmoney.com/a/202606033759275234.html"},{"date":"2026-10-21 17:45:59","image":"","code":"202610213902731033","title":"警方称问界汽车<em>事故</em>司机已遇难","content":"10月21日，神木警方称，该<em>事故</em>系一起单方<em>事故</em>，事发车上仅司机一人，已遇难。问界公司称，该车起火原因为高速情况下车辆机舱遭受剧烈撞击引发线路短路及油液泄漏，导致起火燃烧。目前神木交警部门仍在进一步调查中。","mediaName":"新京报","url":"http://finance.eastmoney.com/a/202610213902731033.html"},{"date":"2026-07-03 21:30:18","image":"","code":"202607033793834124","title":"新恒泰：嘉兴厂区发生火灾<em>事故</em>","content":"新恒泰公告称，2026年7月3日公司位于嘉兴南湖区新丰镇工业园区的1号厂房发生火灾，火情已扑灭，无人员伤亡、未对周边环境造成重大影响，<em>事故</em>原因正在调查核实。本次<em>事故</em>致1号厂房生产设备、物料等受损，具体损失尚在评估中。","mediaName":"财联社","url":"http://finance.eastmoney.com/a/202607033793834124.html"},{"date":"2026-11-08 20:50:43","image":"","code":"202611083925656650","title":"埃及发生列车脱轨<em>事故</em>致至少50人受伤","content":"据埃及方面8日消息，一列由埃及首都开罗开往该国南部阿斯旺的列车当天在埃及吉萨省境内发生脱轨<em>事故</em>，4节车厢脱轨，导致至少50人受伤。","mediaName":"央视新闻","url":"http://finance.eastmoney.com/a/202611083925656650.html"},{"date":"2026-07-28 17:14:19","image":"","code":"202607283823567710","title":"驻韩美军基地发生白磷泄漏<em>事故</em>","content":"据韩国媒体7月28日报道，驻韩美军乌山空军基地发生白磷泄漏<em>事故</em>，消防部门和警方正在调查<em>事故</em>原因。","mediaName":"新华社","url":"http://global.eastmoney.com/a/202607283823567710.html"},{"date":"2026-10-25 21:53:41","image":"","code":"202610253907308149","title":"韩国警方加强万圣节期间安保<em> </em>严防踩踏<em>事故</em>","content":"2022年10月29日晚，大量民众在梨泰院一带参加万圣节派对时发生踩踏<em>事故</em>，造成159人死亡、196人受伤。警方发布的调查结果显示，这是一起“人为造成”的悲剧，归咎于多个部门事前未制定有效防范措施、事发后未能及时应对。","mediaName":"新华社","url":"http://finance.eastmoney.com/a/202610253907308149.html"},{"date":"2026-05-29 12:35:14","image":"","code":"202605293754138127","title":"NASA将评估蓝色起源公司火箭爆炸<em>事故</em>影响","content":"美国国家航空航天局（NASA）局长艾萨克曼随后在社交媒体平台发文表示，NASA已获悉此次<em>事故</em>。","mediaName":"界面新闻","url":"http://finance.eastmoney.com/a/202605293754138127.html"},{"date":"2026-07-10 06:01:50","image":"","code":"202607103800508443","title":"福建晋江鞋厂火灾<em>事故</em>已造成28人遇难<em> </em>应急管理部派联合工作组赴晋江指导<em>事故</em>救援","content":"严肃<em>事故</em>调查工作，准确认定<em>事故</em>性质和责任，坚决依规依纪严肃追责、严厉惩处，给人民群众一个负责任的交代。 　　各工作组已迅速启动运行，各项工作正在进行中。","mediaName":"人民日报","url":"http://finance.eastmoney.com/a/202607103800508443.html"},{"date":"2026-05-25 21:19:00","image":"","code":"202605253748437146","title":"双乐股份子公司发生安全<em>事故</em>：一名操作工死亡，<em>事故</em>原因尚在调查确认中","content":"5月25日，双乐颜料股份有限公司（双乐股份，301036.SZ）发布关于子公司发生安全<em>事故</em>的公告。 　　公告显示，双乐股份子公司双乐颜料泰兴市有限公司(简称“双乐泰兴”)于当日发生一起安全<em>事故</em>，<em>事故</em>造成一名操作工死亡。","mediaName":"澎湃新闻","url":"http://finance.eastmoney.com/a/202605253748437146.html"},{"date":"2026-07-28 13:36:46","image":"","code":"202607283823377486","title":"兴<em>业</em>银锡子公司发生安全<em>事故</em>致1人死亡，<em>事故</em>原因调查中，目前采区已停产，选厂正常生产","content":"7月28日，兴业银锡（000426）发布公告，2026年7月26日下午15时30分，公司全资子公司银漫矿业在矿山井下施工过程中发生安全<em>事故</em>，导致1人死亡，未有其他人员受伤。 　　<em>事故</em>发生后，公司及时向当地应急管理部门报告，目前<em>事故</em>原因仍在调查中。","mediaName":"深圳商报·读创","url":"http://finance.eastmoney.com/a/202607283823377486.html"}]},"searchId":"d2e58e0c-7c7b-42ee-b36c-51b3435dc87e"})